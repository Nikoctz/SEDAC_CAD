		<region region-id="146" left="18" top="5072.25" width="489.75" height="36" align-x="18" align-y="5082" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#253746">Euler supone una columna ideal con longitud efectiva 2Le. El pandeo local supone una pared</c>
					</f>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#253746">apoyada y sin agujeros. Si SigCr supera SyR, la fluencia ocurre antes que ese pandeo</c>
					</f>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#253746">elástico.</c>
					</f>
				</p>
			</text>
			<rendering item-idref="146"/>
		</region>
		<region region-id="147" left="18" top="5114.25" width="489.75" height="24" align-x="18" align-y="5124" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#8a4a12">No se han calculado pandeo flexotorsional, imperfecciones ni estabilidad de las uniones. No</c>
					</f>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#8a4a12">se interpreta nEuler como seguridad global.</c>
					</f>
				</p>
			</text>
			<rendering item-idref="147"/>
		</region>
