					<f family="Arial" charset="0" size="9">
						<c val="#687a88">Memoria editable en Mathcad clásico. Diseño de referencia: P2.02, 15/10/2026.</c>
					</f>
				</p>
			</text>
			<rendering item-idref="3"/>
