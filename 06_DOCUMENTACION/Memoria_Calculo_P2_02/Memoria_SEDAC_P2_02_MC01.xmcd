		<region region-id="4" left="18" top="110.25" width="489.75" height="24" align-x="18" align-y="120" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#253746">Se estudia un sistema auxiliar para apoyar y estabilizar una bomba de espalda. Se revisan</c>
					</f>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#253746">rieles, cuna, cartelas, anclajes y uniones con modelos analíticos simplificados.</c>
					</f>
				</p>
			</text>
			<rendering item-idref="4"/>
		</region>
		<region region-id="5" left="18" top="158.25" width="489.75" height="36" align-x="18" align-y="168" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#8a4a12">Las entradas azules son hipótesis de prediseño. La bomba real, el arnés, la temperatura y el</c>
					</f>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#8a4a12">espectro de fatiga siguen pendientes. Un margen calculado no acredita la seguridad del</c>
					</f>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#8a4a12">conjunto.</c>
					</f>
				</p>
			</text>
			<rendering item-idref="5"/>
		</region>
