		<region region-id="250" left="18" top="8786.25" width="489.75" height="24" align-x="18" align-y="8796" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<b>
							<c val="#a02b21">Con las entradas iniciales, el caso de carga localizada en el borde no alcanza el margen</c>
						</b>
					</f>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<b>
							<c val="#a02b21">objetivo para el piso de 2,5 mm. La memoria propone comparar 3,5 mm o reducir el voladizo.</c>
						</b>
					</f>
				</p>
			</text>
			<rendering item-idref="250"/>
		</region>
		<region region-id="251" left="18" top="8828.25" width="489.75" height="24" align-x="18" align-y="8838" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#253746">La alternativa tfProp es una evaluación de cálculo. El CAD P2.02 conserva 2,5 mm: esta</c>
					</f>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#253746">memoria no modifica automáticamente el modelo.</c>
					</f>
				</p>
			</text>
			<rendering item-idref="251"/>
		</region>
		<region region-id="252" left="18" top="8864.25" width="489.75" height="24" align-x="18" align-y="8874" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#253746">El contacto real de una bolsa flexible puede distribuir la fuerza de otra forma. El parche</c>
					</f>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#253746">de 100 N y su ancho son hipótesis que deben contrastarse.</c>
					</f>
				</p>
			</text>
			<rendering item-idref="252"/>
