		<region region-id="340" left="18" top="11954.25" width="489.75" height="36" align-x="18" align-y="11964" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<b>
							<c val="#a02b21">La revisión corrige dos aspectos del cálculo previo: suma vectorial en M8 y parche en el</c>
						</b>
					</f>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<b>
							<c val="#a02b21">borde del piso. Con entradas iniciales, la cuna requiere revisión para alcanzar el margen</c>
						</b>
					</f>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<b>
							<c val="#a02b21">objetivo.</c>
						</b>
					</f>
				</p>
			</text>
			<rendering item-idref="340"/>
		</region>
		<region region-id="341" left="18" top="12147" width="489.75" height="11.25" align-x="18" align-y="12156" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto">
