				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#253746">El cálculo anterior revisa cortante externo del M8; no verifica tracción por palanca,</c>
					</f>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#253746">apertura, precarga, aplastamiento bajo cabeza/arandela ni pérdida de apriete. Los casquillos</c>
					</f>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#253746">deben ajustar al tubo real.</c>
					</f>
				</p>
			</text>
			<rendering item-idref="209"/>
		</region>
		<region region-id="210" left="18" top="7310.25" width="489.75" height="24" align-x="18" align-y="7320" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto">
