					<f family="Arial" charset="0" size="10">
						<c val="#253746">Para aceptar cada precriterio de fluencia: n &gt;= nReq. Para flecha: deltaR &lt;= deltaLim. Los</c>
					</f>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#253746">resultados se recalculan al modificar las entradas de páginas anteriores.</c>
					</f>
				</p>
			</text>
			<rendering item-idref="324"/>
