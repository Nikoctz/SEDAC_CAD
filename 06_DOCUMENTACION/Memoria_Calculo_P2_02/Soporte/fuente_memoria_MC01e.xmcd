/><ml:id xml:space="preserve">Kb</ml:id><ml:apply><ml:sqrt/><ml:apply><ml:plus/><ml:apply><ml:pow/><ml:parens><ml:apply><ml:div/><ml:id xml:space="preserve">Vy</ml:id><ml:real>2</ml:real></ml:apply></ml:parens><ml:real>2</ml:real></ml:apply><ml:apply><ml:pow/><ml:parens><ml:apply><ml:plus/><ml:apply><ml:div/><ml:id xml:space="preserve">Vz</ml:id><ml:real>2</ml:real></ml:apply><ml:apply><ml:div/><ml:id xml:space="preserve">MomC</ml:id><ml:id xml:space="preserve">pitch</ml:id></ml:apply></ml:apply></ml:parens><ml:real>2</ml:real></ml:apply></ml:apply></ml:apply></ml:apply></ml:define></math></region><region region-id="167" left="20" top="5930.23" width="150" height="34" align-x="20" align-y="5952.33" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_R8"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">R8</ml:id><ml:unitOverride><ml:id xml:space="preserve">N</ml:id></ml:unitOverride></ml:eval></math></region><region region-id="168" left="16" top="5965.23" width="490" height="32" align-x="16" align-y="5986.03" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#8A4A12">Corrección: la fuerza horizontal directa y el esfuerzo producido por el momento se suman en</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#8A4A12">el tornillo crítico antes de obtener la resultante. R8old se conserva solo para comparar.</c></f></p></text></region><region region-id="169" left="16" top="6079.12" width="490" height="20" align-x="16" align-y="6092.12" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" si