erve">t</ml:id><ml:id xml:space="preserve">bp</ml:id></ml:apply></ml:parens><ml:real>2</ml:real></ml:apply></ml:apply></ml:define></math></region><region region-id="143" left="20" top="4964.34" width="150" height="34" align-x="20" align-y="4986.4400000000005" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_SigCr"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">SigCr</ml:id><ml:unitOverride><ml:id xml:space="preserve">MPa</ml:id></ml:unitOverride></ml:eval></math></region><region region-id="144" left="16" top="4999.34" width="330" height="48" align-x="16" align-y="5030.54" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="SigCap"><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">SigCap</ml:id><ml:apply><ml:id xml:space="preserve">min</ml:id><ml:sequence><ml:id xml:space="preserve">SyR</ml:id><ml:id xml:space="preserve">SigCr</ml:id></ml:sequence></ml:apply></ml:define></math></region><region region-id="145" left="355" top="4999.34" width="150" height="48" align-x="355" align-y="5030.54" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_SigCap"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">SigCap</ml:id><ml:unitOverride><ml:id xml:space="preserve">MPa</ml:id></ml:unitOverride></ml:eval></math></region><region region-id="146" left="16" top="5051.34" width="490" height="45" align-x="16" align-y="5080.59" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">Euler supone una columna ideal con longitud efectiva 2Le. El pandeo local supone una pared</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">apoyada y sin agujeros. Si SigCr supera SyR, la fluencia ocurre antes que ese pandeo</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">elástico.</c></f></p></text></region><region region-id="147" left="16" top="5102.34" width="490" height="32" align-x="16" align-y="5123.14" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#8A4A12">No se han calculado pandeo flexotorsional, imperfecciones ni estabilidad de las uniones. No</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#8A4A12">se interpreta nEuler como seguridad global.</c></f></p></text></region><region region-id="148" left="16" top="5321.23" width="490" height="20" align-x="16" align-y="5334.23" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="9"><b><c val="#687A88">SEDAC / P2.02 / MC01</c></b></f></p></text></region><region region-id="149" left="16" top="5347.23" width="490" height="28" align-x="16" align-y="5365.429999999999" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="14"><b><c val="#123B54">8. Cartelas: tornillos M8 y reparto de esfuerzos</c></b></f></p></text></region><region region-id="150" left="16" top="5381.23" width="330" height="48" align-x="16" align-y="5412.429999999999" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="#F0F6FC" tag="pitch"><math optimize="false" disable-calc="false"><ml:defin