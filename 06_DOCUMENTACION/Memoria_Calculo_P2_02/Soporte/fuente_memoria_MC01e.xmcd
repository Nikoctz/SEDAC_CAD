6, criterios y verificaciones que siguen abiertas</c></b></f></p></text></region><region region-id="309" left="16" top="10686.46" width="330" height="48" align-x="16" align-y="10717.66" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="#F0F6FC" tag="As6"><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">As6</ml:id><ml:apply><ml:mult/><ml:real>20.1</ml:real><ml:apply><ml:pow/><ml:id xml:space="preserve">mm</ml:id><ml:real>2</ml:real></ml:apply></ml:apply></ml:define></math></region><region region-id="310" left="355" top="10686.46" width="150" height="48" align-x="355" align-y="10717.66" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_As6"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">As6</ml:id><ml:unitOverride><ml:apply><ml:pow/><ml:id xml:space="preserve">mm</ml:id><ml:real>2</ml:real></ml:apply></ml:unitOverride></ml:eval></math></region><region region-id="311" left="16" top="10738.46" width="330" height="48" align-x="16" align-y="10769.66" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="R6"><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">R6</ml:id><ml:apply><ml:div/><ml:apply><ml:mult/><ml:apply><ml:mult/><ml:id xml:space="preserve">Kb</ml:id><ml:id xml:space="preserve">eta</ml:id></ml:apply><ml:id xml:space="preserve">Fv</ml:id></ml:apply><ml:real>2</ml:real></ml:apply></ml:define></math></region><region region-id="312" left="355" top="10738.46" width="150" height="48" align-x="355" align-y="10769.66" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_R6"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">R6</ml:id><ml:unitOverride><ml:id xml:space="preserve">N</ml:id></ml:unitOverride></ml:eval></math></region><region region-id="313" left="16" top="10790.46" width="330" height="48" align-x="16" align-y="10821.66" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="VM6"><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">VM6</ml:id><ml:apply><ml:div/><ml:apply><ml:mult/><ml:apply><ml:sqrt/><ml:real>3</ml:real></ml:apply><ml:id xml:space="preserve">R6</ml:id></ml:apply><ml:id xml:space="preserve">As6</ml:id></ml:apply></ml:define></math></region><region region-id="314" left="355" top="10790.46" width="150" height="48" align-x="355" align-y="10821.66" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_VM6"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">VM6</ml:id><ml:unitOverride><ml:id xml:space="preserve">MPa</ml:id></ml:unitOverride></ml:eval></math></region><region region-id="315" left="16" top="10842.46" width="330" height="48" align-x="16" align-y="10873.66" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="nM6"><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">nM6</ml:id><ml:apply><ml:div/><ml:id xml:space="preserve">SyB</ml:id><ml:id xml:space="preserve">VM6</ml:id></ml:apply></ml:define></math></region><region region-id="316" left="355" top="10842.46" width="150" height="48" align-x="355" align-y="10873.66" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_nM6"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">nM6</ml:id></ml:eval></math></region><region region-id="317" left="16" top="10894.46" width="490" height="48" align-x="16" align-y="10925.66" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="MinYield"><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">MinYield</ml:id><ml:apply><ml:id xml:space="preserve">min</ml:id><ml:sequence><ml:id xml:space="preserve">nR</ml:id><ml:id xml:space="preserve">nBolt8</ml:id><ml:id xml:space="preserve">nBearR</ml:id><ml:id xml:space="preserve">nBearG</ml:id><ml:id xml:space="preserve">nTearG</ml:id><ml:id xml:space="preserve">nRoot</ml:id><ml:id xml:space="preserve">nFloor</ml:id><ml:id xml:space="preserve">nRib</ml:id><ml:id xml:space="preserve">nSlot</ml:id><ml:id xml:space="preserve">nBelt</ml:id><ml:id xml:space="preserve">nYoke</ml:id><ml:id xml:space="preserve">nX</ml:id><ml:id xml:space="preserve">nM6</ml:id></ml:sequence></ml:apply></ml:define></math></region><region region-id="318" left="20" top="10946.46" width="150" height="34" align-x="20" align-y="10968.56" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_MinYield"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">MinYield</ml:id></ml:eval></math></region><region region-id="319" left="16" top="10981.46" width="490" height="32" align-x="16" align-y="11002.259999999998" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">MinYield reúne márgenes de modelos parciales para localizar el resultado menor. No</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">representa un factor de seguridad global del sistema.</c></f></p></text></region><region region-id="320" left="16" top="11019.46" width="490" height="58" align-x="16" align-y="11057.16" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">Fatiga: falta espectro de ciclos y curvas S-N del detalle real. No se asigna vida útil.</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">Uniones: faltan tracción, precarga, aflojamiento y palanca.</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">Temperatura: materiales de contacto sin calificación para fuego.</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">Ergonomía: faltan mediciones de bomba, cuerpo, arnés y presión de contacto.</c></f></p></text></region><region region-id="321" left="16" top="11083.46" width="490" height="32" align-x="16" align-y="11104.259999999998" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#8A4A12">El criterio de Von Mises se aplica como aproximación a fluencia de materiales dúctiles. No</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#8A4A12">sustituye criterios de fractura, fatiga ni ensayos de los textiles.</c></f></p></text></region><region region-id="322" left="16" top="11384.35" width="490" height="20" align-x="16" align-y="11397.35" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="9"><b><c val="#687A88">SEDAC / P2.02 / MC01</c></b></f></p></text></region><region region-id="323" left="16" top="11410.35" width="490" height="28" align-x="16" align-y="11428.550000000001" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="14"><b><c val="#123B54">16. Resumen calculado y comparación con P2.02</c></b></f></p></text></region><region region-id="324" left="16" top="11444.35" width="490" height="32" align-x="16" align-y="11465.15" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">Para aceptar cada precriterio de fluencia: n &gt;= nReq. Para flecha: deltaR &lt;= deltaLim. Los</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">resultados se recalculan al modificar las entradas de páginas anteriores.</c></f></p></text></region><region region-id="325" left="22" top="11482.35" width="150" height="34" align-x="22" align-y="11504.45" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_nReq"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">nReq</ml:id></ml:eval></math></region><region region-id="326" left="22" top="11512.35" width="150" height="34" align-x="22" align-y="11534.45" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_nR"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">nR</ml:id></ml:eval></math></region><region region-id="327" left="22" top="11542.35" width="150" height="34" align-x="22" align-y="11564.45" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_deltaR"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">deltaR</ml:id><ml:unitOverride><ml:id xml:space="preserve">mm</ml:id></ml:unitOverride></ml:eval></math></region><region region-id="328" left="22" top="11572.35" width="150" height="34" align-x="22" align-y="11594.45" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_nBolt8"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">nBolt8</ml:id></ml:eval></math></region><region region-id="329" left="22" top="11602.35" width="150" height="34" align-x="22" align-y="11624.45" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_nBearR"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">nBearR</ml:id></ml:eval></math></region><region region-id="330" left="22" top="11632.35" width="150" height="34" align-x="22" align-y="11654.45" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_nBearG"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">nBearG</ml:id></ml:eval></math></region><region region-id="331" left="22" top="11662.35" width="150" height="34" align-x="22" align-y="11684.45" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_nTearG"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">nTearG</ml:id></ml:eval></math></region><region region-id="332" left="22" top="11692.35" width="150" height="34" align-x="22" align-y="11714.45" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_nRoot"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">nRoot</ml:id></ml:eval></math></region><region region-id="333" left="22" top="11722.35" width="150" height="34" align-x="22" align-y="11744.45" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_nFloor"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">nFloor</ml:id></ml:eval></math></region><region region-id="334" left="22" top="11752.35" width="150" height="34" align-x="22" align-y="11774.45" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_nRib"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">nRib</ml:id></ml:eval></math></region><region region-id="335" left="22" top="11782.35" width="150" height="34" align-x="22" align-y="11804.45" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_nSlot"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">nSlot</ml:id></ml:eval></math></region><region region-id="336" left="22" top="11812.35" width="150" height="34" align-x="22" align-y="11834.45" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_nBelt"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">nBelt</ml:id></ml:eval></math></region><region region-id="337" left="22" top="11842.35" width="150" height="34" align-x="22" align-y="11864.45" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_nYoke"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">nYoke</ml:id></ml:eval></math></region><region region-id="338" left="22" top="11872.35" width="150" height="34" align-x="22" align-y="11894.45" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_nX"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">nX</ml:id></ml:eval></math></region><region region-id="339" left="22" top="11902.35" width="150" height="34" align-x="22" align-y="11924.45" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_nM6"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">nM6</ml:id></ml:eval></math></region><region region-id="340" left="16" top="11932.35" width="490" height="45" align-x="16" align-y="11961.6" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="10"><b><c val="#A02B21">La revisión corrige dos aspectos del cálculo previo: suma vectorial en M8 y parche en el</c></b></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><b><c val="#A02B21">borde del piso. Con entradas iniciales, la cuna requiere revisión para alcanzar el margen</c></b></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><b><c val="#A02B21">objetivo.</c></b></f></p></text></region><region region-id="341" left="16" top="12142.24" width="490" height="20" align-x="16" align-y="12155.24" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="9"><b><c val="#687A88">SEDAC / P2.02 / MC01</c></b></f></p></text></region><region region-id="342" left="16" top="12168.24" width="490" height="28" align-x="16" align-y="12186.44" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="14"><b><c val="#123B54">17. Estado del modelo, fuentes y uso de la memoria</c></b></f></p></text></region><region region-id="343" left="16" top="12202.24" width="490" height="45" align-x="16" align-y="12231.49" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">Modelo geométrico de referencia: 54 diseños de piezas, 70 ocurrencias y cero interferencias</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">volumétricas en Inventor. Masa representada aproximada: 3,206 kg, sin arnés completo. Estos</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">datos son registros del CAD; no se recalculan al editar esta hoja.</c></f></p></text></region><region region-id="344" left="16" top="12253.24" width="490" height="32" align-x="16" align-y="12274.039999999999" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">Las dimensiones oficiales de bolsa vacía no describen la forma de la bolsa llena. La masa de</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">referencia de 25 kg y los factores de carga fueron elegidos para prediseño.</c></f></p></text></region><region region-id="345" left="16" top="12291.24" width="490" height="123" align-x="16" align-y="12371.19" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">Fuentes técnicas:</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">[1] Scotty Firefighter, catálogo oficial, Alpha Backpack 4000-BP: capacidad 19 L y conexión</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">inferior central.</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">[2] Hydro, Alloy 6061, ficha de extrusión: propiedades según temple y producto.</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">[3] Atlas Steels, ficha 5052 y Technical Note 14: propiedades y diferencias entre</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">especificaciones.</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">[4] Bossard, Stainless steel fasteners, ISO 3506: clase A2-70.</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">[5] NASA RP-1228, Fastener Design Manual, 1990: revisión de grupos de tornillos y cargas</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">combinadas.</c></f></p></text></region><region region-id="346" left="16" top="12470.24" width="490" height="32" align-x="16" align-y="12491.039999999999" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">Enlaces completos y auditoría: LEEME_MEMORIA.md y REVISION_CALCULOS.md, junto a esta hoja.</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">No se declara conformidad con normas aeroespaciales.</c></f></p></text></region><region region-id="347" left="16" top="12508.24" width="490" height="45" align-x="16" align-y="12537.49" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">Uso: editar entradas azules, recalcular la hoja y revisar los márgenes y unidades. La</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">modificación de esta memoria no actualiza el CAD ni sus archivos JSON. Al cambiar la</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">geometría deben revisarse apoyos, brazos y cargas.</c></f></p></text></region><region region-id="348" left="16" top="12559.24" width="490" height="30" align-x="16" align-y="12578.74" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="9"><c val="#253746">Fecha de revisión: 15/10/2026. Versión documental MC01. Documento de trabajo sujeto a</c></f></p><p style="Normal"><f family="Arial" charset="0" size="9"><c val="#253746">revisión técnica y pruebas de banco.</c></f></p></text></region></regions></worksheet>