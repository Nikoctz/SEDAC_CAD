/><ml:id xml:space="preserve">SyS</ml:id><ml:id xml:space="preserve">TearG</ml:id></ml:apply></ml:define></math></region><region region-id="192" left="355" top="6673.12" width="150" height="48" align-x="355" align-y="6704.32" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_nTearG"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">nTearG</ml:id></ml:eval></math></region><region region-id="193" left="16" top="6725.12" width="490" height="32" align-x="16" align-y="6745.92" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">Se usa una sola pared del tubo para aplastamiento y sección resistente de rosca para</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">cortante del tornillo. Sin crédito de fricción ni reparto por la segunda pared.</c></f></p></text></region><region region-id="194" left="16" top="6837.01" width="490" height="20" align-x="16" align-y="6850.01" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="9"><b><c val="#687A88">SEDAC / P2.02 / MC01</c></b></f></p></text></region><region region-id="195" left="16" top="6863.01" width="490" height="28" align-x="16" align-y="6881.21" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="14"><b><c val="#123B54">10. Cartela: raíz y límites de la unión</c></b></f></p></text></region><region region-id="196" left="16" top="6897.01" width="330" height="48" align-x="16" align-y="6928.21" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="#F0F6FC" tag="hRoot"><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">hRoot</ml:id><ml:apply><ml:mult/><ml:real>80</ml:real><ml:id xml:space="preserve">mm</ml:id></ml:apply></ml:define></math></region><region region-id="197" left="355" top="6897.01" width="150" height="48" align-x="355" align-y="6928.21" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_hRoot"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">hRoot</ml:id><ml:unitOverride><ml:id xml:space="preserve">mm</ml:id></ml:unitOverride></ml:eval></math></region><region region-id="198" left="16" top="6949.01" width="330" height="48" align-x="16" align-y="6980.21" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="Vcart"><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">Vcart</ml:id><ml:apply><ml:sqrt/><ml:apply><ml:plus/><ml:apply><ml:pow/><ml:id xml:space="preserve">Vy</ml:id><ml:real>2</ml:real></ml:apply><ml:apply><ml:pow/><ml:id xml:space="preserve">Vz</ml:id><ml:real>2</ml:real></ml:apply></ml:apply></ml:apply></ml:define></math></region><region region-id="199" left="355" top="6949.01" width="150" height="48" align-x="355" align-y="6980.21" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_Vcart"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">Vcart</ml:id><ml:unitOverride><ml:id xml:space="preserve">N</ml:id></ml:unitOverride></ml:eval></math></region><region region-id="200" left="16" top="7001.01" width="330" height="48" align-x="16" align-y="7032.21" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="SigRoot"><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">SigRoot</ml:id><ml:apply><ml:div/><ml:apply><ml:mult/><ml:real>6</ml:real><ml:id xml:space="preserve">MomC</ml:id></ml:apply><ml:apply><ml:mult/><ml:id xml:space="preserve">tg</ml:id><ml:apply><ml:pow/><ml:id xml:space="preserve">hRoot</ml:id><ml:real>2</ml:real></ml:apply></ml:apply></ml:apply></ml:define></math></region><region region-id="201" left="355" top="7001.01" width="150" height="48" align-x="355" align-y="7032.21" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_SigRoot"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">SigRoot</ml:id><ml:unitOverride><ml:id xml:space="preserve">MPa</ml:id></ml:unitOverride></ml:eval></math></region><region region-id="202" left="16" top="7053.01" width="330" height="48" align-x="16" align-y="7084.21" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="TauRoot"><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">TauRoot</ml:id><ml:apply><ml:div/><ml:id xml:space="preserve">Vcart</ml:id><ml:apply><ml:mult/><ml:id xml:space="preserve">tg</ml:id><ml:id xml:space="preserve">hRoot</ml:id></ml:apply></ml:apply></ml:define></math></region><region region-id="203" left="355" top="7053.01" width="150" height="48" align-x="355" align-y="7084.21" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_TauRoot"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">TauRoot</ml:id><ml:unitOverride><ml:id xml:space="preserve">MPa</ml:id></ml:unitOverride></ml:eval></math></region><region region-id="204" left="16" top="7105.01" width="330" height="48" align-x="16" align-y="7136.21" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="VMroot"><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">VMroot</ml:id><ml:apply><ml:mult/><ml:real>2</ml:real><ml:apply><ml:sqrt/><ml:apply><ml:plus/><ml:apply><ml:pow/><ml:id xml:space="preserve">SigRoot</ml:id><ml:real>2</ml:real></ml:apply><ml:apply><ml:mult/><ml:real>3</ml:real><ml:apply><ml:pow/><ml:id xml:space="preserve">TauRoot</ml:id><ml:real>2</ml:real></ml:apply></ml:apply></ml:apply></ml:apply></ml:apply></ml:define></math></region><region region-id="205" left="355" top="7105.01" width="150" height="48" align-x="355" align-y="7136.21" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_VMroot"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">VMroot</ml:id><ml:unitOverride><ml:id xml:space="preserve">MPa</ml:id></ml:unitOverride></ml:eval></math></region><region region-id="206" left="16" top="7157.01" width="330" height="48" align-x="16" align-y="7188.21" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="nRoot"><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">nRoot</ml:id><ml:apply><ml:div/><ml:id xml:space="preserve">SyS</ml:id><ml:id xml:space="preserve">VMroot</ml:id></ml:apply></ml:define></math></region><region region-id="207" left="355" top="7157.01" width="150" height="48" align-x="355" align-y="7188.21" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_nRoot"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">nRoot</ml:id></ml:eval></math></region><region region-id="208" left="16" top="7209.01" width="490" height="32" align-x="16" align-y="7229.81" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">Modelo de sección rectangular idealizada con amplificación local 2. El recorte de</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">aligeramiento, el pliegue y el ala requieren un análisis local.</c></f></p></text></region><region region-id="209" left="16" top="7247.01" width="490" height="45" align-x="16" align-y="7276.26" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">El cálculo anterior revisa cortante externo del M8; no verifica tracción por palanca,</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">apertura, precarga, aplastamiento bajo cabeza/arandela ni pérdida de apriete. Los casquillos</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">deben ajustar al tubo real.</c></f></p></text></region><region region-id="210" left="16" top="7298.01" width="490" height="32" align-x="16" align-y="7318.81" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">La posición de las fijaciones principales evita depender de plástico comprimido para</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">sostener la precarga. La longitud y tolerancia de casquillos aún deben especificarse.</c></f></p></text></region><region region-id="211" left="16" top="7594.9" width="490" height="20" align-x="16" align-y="7607.9" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="9"><b><c val="#687A88">SEDAC / P2.02 / MC01</c></b></f></p></text></region><region region-id="212" left="16" top="7620.9" width="490" height="28" align-x="16" align-y="7639.099999999999" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="14"><b><c val="#123B54">11. Cuna: apoyo del piso y cargas locales</c></b></f></p></text></region><region region-id="213" left="16" top="7654.9" width="330" height="48" align-x="16" align-y="7686.099999999999" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="#F0F6FC" tag="Width"><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">Width</ml:id><ml:apply><ml:mult/><ml:real>300</ml:real><ml:id xml:space="preserve">mm</ml:id></ml:apply></ml:define></math></region><region region-id="214" left="355" top="7654.9" width="150" height="48" align-x="355" align-y="7686.099999999999" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_Width"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">Width</ml:id><ml:unitOverride><ml:id xml:space="preserve">mm</ml:id></ml:unitOverride></ml:eval></math></region><region region-id="215" left="16" top="7706.9" width="330" height="48" align-x="16" align-y="7738.099999999999" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="#F0F6FC" tag="Depth"><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">Depth</ml:id><ml:apply><ml:mult/><ml:real>125</ml:real><ml:id xml:space="preserve">mm</ml:id></ml:apply></ml:define></math></region><region region-id="216" left="355" top="7706.9" width="150" height="48" align-x="355" align-y="7738.099999999999" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_Depth"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">Depth</ml:id><ml:unitOverride><ml:id xml:space="preserve">mm</ml:id></ml:unitOverride></ml:eval></math></region><region region-id="217" left="16" top="7758.9" width="330" height="48" align-x="16" align-y="7790.099999999999" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="#F0F6FC" tag="tf"><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">tf</ml:id><ml:apply><ml:mult/><ml:real>2.5</ml:real><ml:id xml:space="preserve">mm</ml:id></ml:apply></ml:define></math></region><region region-id="218" left="355" top="7758.9" width="150" height="48" align-x="355" align-y="7790.099999999999" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_tf"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">tf</ml:id><ml:unitOverride><ml:id xml:space="preserve">mm</ml:id></ml:unitOverride></ml:eval></math></region><region region-id="219" left="16" top="7810.9" width="330" height="48" align-x="16" align-y="7842.099999999999" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="spanF"><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">spanF</ml:id><ml:apply><ml:minus/><ml:id xml:space="preserve">Depth</ml:id><ml:apply><ml:mult/><ml:real>60</ml:real><ml:id xml:space="preserve">mm</ml:id></ml:apply></ml:apply></ml:define></math></region><region region-id="220" left="355" top="7810.9" width="150" height="48" align-x="355" align-y="7842.099999999999" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_spanF"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">spanF</ml:id><ml:unitOverride><ml:id xml:space="preserve">mm</ml:id></ml:unitOverride></ml:eval></math></region><region region-id="221" left="16" top="7862.9" width="330" height="48" align-x="16" align-y="7894.099999999999" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="#F0F6FC" tag="over"><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">over</ml:id><ml:apply><ml:mult/><ml:real>40</ml:real><ml:id xml:space="preserve">mm</ml:id></ml:apply></ml:define></math></region><region region-id="222" left="355" top="7862.9" width="150" height="48" align-x="355" align-y="7894.099999999999" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_over"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">over</ml:id><ml:unitOverride><ml:id xml:space="preserve">mm</ml:id></ml:unitOverride></ml:eval></math></region><region region-id="223" left="16" top="7914.9" width="330" height="48" align-x="16" align-y="7946.099999999999" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="#F0F6FC" tag="Ppatch"><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">Ppatch</ml:id><ml:apply><ml:mult/><ml:real>100</ml:real><ml:id xml:space="preserve">N</ml:id></ml:apply></ml:define></math></region><region region-id="224" left="355" top="7914.9" width="150" height="48" align-x="355" align-y="7946.099999999999" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_Ppatch"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">Ppatch</ml:id><ml:unitOverride><ml:id xml:space="preserve">N</ml:id></ml:unitOverride></ml:eval></math></region><region region-id="225" left="16" top="7966.9" width="330" height="48" align-x="16" align-y="7998.099999999999" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="#F0F6FC" tag="strip"><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">strip</ml:id><ml:apply><ml:mult/><ml:real>50</ml:real><ml:id xml:space="preserve">mm</ml:id></ml:apply></ml:define></math></region><region region-id="226" left="355" top="7966.9" width="150" height="48" align-x="355" align-y="7998.099999999999" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_strip"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">strip</ml:id><ml:unitOverride><ml:id xml:space="preserve">mm</ml:id></ml:unitOverride></ml:eval></math></region><region region-id="227" left="16" top="8018.9" width="330" height="48" align-x="16" align-y="8050.099999999999" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="qfloor"><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">qfloor</ml:id><ml:apply><ml:div/><ml:apply><ml:mult/><ml:real>2</ml:real><ml:id xml:space="preserve">Fv</ml:id></ml:apply><ml:apply><ml:mult/><ml:id xml:space="preserve">Width</ml:id><ml:id xml:space="preserve">Depth</ml:id></ml:apply></ml:apply></ml:define></math></region><region region-id="228" left="355" top="8018.9" width="150" height="48" align-x="355" align-y="8050.099999999999" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_qfloor"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">qfloor</ml:id><ml:unitOverride><ml:id xml:space="preserve">MPa</ml:id></ml:unitOverride></ml:eval></math></region><region region-id="229" left="16" top="8070.9" width="330" height="48" align-x="16" align-y="8102.099999999999" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="Mspan"><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">Mspan</ml:id><ml:apply><ml:plus/><ml:apply><ml:div/><ml:apply><ml:mult/><ml:id xml:space="preserve">qfloor</ml:id><ml:apply><ml:pow/><ml:id xml:space="preserve">spanF</ml:id><ml:real>2</ml:real></ml:apply></ml:apply><ml:real>8</ml:real></ml:apply><ml:apply><ml:div/><ml:apply><ml:mult/><ml:id xml:space="preserve">Ppatch</ml:id><ml:id xml:space="preserve">spanF</ml:id></ml:apply><ml:apply><ml:mult/><ml:real>4</ml:real><ml:id xml:space="preserve">strip</ml:id></ml:apply></ml:apply></ml:apply></ml:define></math></region><region region-id="230" left="355" top="8070.9" width="150" height="48" align-x="355" align-y="8102.099999999999" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_Mspan"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">Mspan</ml:id><ml:unitOverride><ml:id xml:space="preserve">N</ml:id></ml:unitOverride></ml:eval></math></region><region region-id="231" left="16" top="8122.9" width="330" height="48" align-x="16" align-y="8154.099999999999" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="Medge"><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">Medge</ml:id><ml:apply><ml:plus/><ml:apply><ml:div/><ml:apply><ml:mult/><ml:id xml:space="preserve">qfloor</ml:id><ml:apply><ml:pow/><ml:id xml:space="preserve">over</ml:id><ml:real>2</ml:real></ml:apply></ml:apply><ml:real>2</ml:real></ml:apply><ml:apply><ml:div/><ml:apply><ml:mult/><ml:id xml:space="preserve">Ppatch</ml:id><ml:id xml:space="preserve">over</ml:id></ml:apply><ml:id xml:space="preserve">strip</ml:id></ml:apply></ml:apply></ml:define></math></region><region region-id="232" left="355" top="8122.9" width="150" height="48" align-x="355" align-y="8154.099999999999" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_Medge"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">Medge</ml:id><ml:unitOverride><ml:id xml:space="preserve">N</ml:id></ml:unitOverride></ml:eval></math></region><region region-id="233" left="16" top="8174.9" width="490" height="58" align-x="16" align-y="8212.6" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">Se usan ejes de refuerzos como líneas de apoyo: separación 65 mm y voladizo 40 mm. El piso</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">se idealiza por franjas de ancho unitario. Mspan y Medge son momentos por unidad de ancho,</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">de unidad N. La carga localizada se coloca por separado entre apoyos y en el extremo del</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">voladizo.</c></f></p></text></region><region region-id="234" left="16" top="8352.789999999999" width="490" height="20" align-x="16" align-y="8365.789999999999" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="9"><b><c val="#687A88">SEDAC / P2.02 / MC01</c></b></f></p></text></region><region region-id="235" left="16" top="8378.789999999999" width="490" height="28" align-x="16" align-y="8396.99" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="14"><b><c val="#123B54">12. Cuna: resultado del caso de borde</c></b></f></p></text></region><region region-id="236" left="16" top="8412.789999999999" width="330" height="48" align-x="16" align-y="8443.99" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="Mfloor"><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">Mfloor</ml:id><ml:apply><ml:id xml:space="preserve">max</ml:id><ml:sequence><ml:id xml:space="preserve">Mspan</ml:id><ml:id xml:space="preserve">Medge</ml:id></ml:sequence></ml:apply></ml:define></math></region><region region-id="237" left="355" top="8412.789999999999" width="150" height="48" align-x="355" align-y="8443.99" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_Mfloor"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">Mfloor</ml:id><ml:unitOverride><ml:id xml:space="preserve">N</ml:id></ml:unitOverride></ml:eval></math></region><region region-id="238" left="16" top="8464.789999999999" width="330" height="48" align-x="16" align-y="8495.99" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="SigFloor"><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">SigFloor</ml:id><ml:apply><ml:div/><ml:apply><ml:mult/><ml:real>6</ml:real><ml:id xml:space="preserve">Mfloor</ml:id></ml:apply><ml:apply><ml:pow/><ml:id xml:space="preserve">tf</ml:id><ml:real>2</ml:real></ml:apply></ml:apply></ml:define></math></region><region region-id="239" left="355" top="8464.789999999999" width="150" height="48" align-x="355" align-y="8495.99" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_SigFloor"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">SigFloor</ml:id><ml:unitOverride><ml:id xml:space="preserve">MPa</ml:id></ml:unitOverride></ml:eval></math></region><region region-id="240" left="16" top="8516.789999999999" width="330" height="48" align-x="16" align-y="8547.99" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="nFloor"><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">nFloor</ml:id><ml:apply><ml:div/><ml:id xml:space="preserve">SyS</ml:id><ml:id xml:space="preserve">SigFloor</ml:id></ml:apply></ml:define></math></region><region region-id="241" left="355" top="8516.789999999999" width="150" height="48" align-x="355" align-y="8547.99" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_nFloor"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">nFloor</ml:id></ml:eval></math></region><region region-id="242" left="16" top="8568.789999999999" width="330" height="48" align-x="16" align-y="8599.99" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="tNeed"><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">tNeed</ml:id><ml:apply><ml:sqrt/><ml:apply><ml:div/><ml:apply><ml:mult/><ml:apply><ml:mult/><ml:real>6</ml:real><ml:id xml:space="preserve">Mfloor</ml:id></ml:apply><ml:id xml:space="preserve">nReq</ml:id></ml:apply><ml:id xml:space="preserve">SyS</ml:id></ml:apply></ml:apply></ml:define></math></region><region region-id="243" left="355" top="8568.789999999999" width="150" height="48" align-x="355" align-y="8599.99" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_tNeed"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">tNeed</ml:id><ml:unitOverride><ml:id xml:space="preserve">mm</ml:id></ml:unitOverride></ml:eval></math></region><region region-id="244" left="16" top="8620.789999999999" width="330" height="48" align-x="16" align-y="8651.99" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="#F0F6FC" tag="tfProp"><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">tfProp</ml:id><ml:apply><ml:mult/><ml:real>3.5</ml:real><ml:id xml:space="preserve">mm</ml:id></ml:apply></ml:define></math></region><region region-id="245" left="355" top="8620.789999999999" width="150" height="48" align-x="355" align-y="8651.99" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_tfProp"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">tfProp</ml:id><ml:unitOverride><ml:id xml:space="preserve">mm</ml:id></ml:unitOverride></ml:eval></math></region><region region-id="246" left="16" top="8672.789999999999" width="330" height="48" align-x="16" align-y="8703.99" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="SigProp"><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">SigProp</ml:id><ml:apply><ml:div/><ml:apply><ml:mult/><ml:real>6</ml:real><ml:id xml:space="preserve">Mfloor</ml:id></ml:apply><ml:apply><ml:pow/><ml:id xml:space="preserve">tfProp</ml:id><ml:real>2</ml:real></ml:apply></ml:apply></ml:define></math></region><region region-id="247" left="355" top="8672.789999999999" width="150" height="48" align-x="355" align-y="8703.99" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_SigProp"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">SigProp</ml:id><ml:unitOverride><ml:id xml:space="preserve">MPa</ml:id></ml:unitOverride></ml:eval></math></region><region region-id="248" left="16" top="8724.789999999999" width="330" height="48" align-x="16" align-y="8755.99" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="nProp"><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">nProp</ml:id><ml:apply><ml:div/><ml:id xml:space="preserve">SyS</ml:id><ml:id xml:space="preserve">SigProp</ml:id></ml:apply></ml:define></math></region><region region-id="249" left="355" top="8724.789999999999" width="150" height="48" align-x="355" align-y="8755.99" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_nProp"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">nProp</ml:id></ml:eval></math></region><region region-id="250" left="16" top="8776.789999999999" width="490" height="32" align-x="16" align-y="8797.589999999998" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="10"><b><c val="#A02B21">Con las entradas iniciales, el caso de carga localizada en el borde no alcanza el margen</c></b></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><b><c val="#A02B21">objetivo para el piso de 2,5 mm. La memoria propone comparar 3,5 mm o reducir el voladizo.</c></b></f></p></text></region><region region-id="251" left="16" top="8814.789999999999" width="490" height="32" align-x="16" align-y="8835.589999999998" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">La alternativa tfProp es una evaluación de cálculo. El CAD P2.02 conserva 2,5 mm: esta</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">memoria no modifica automáticamente el modelo.</c></f></p></text></region><region region-id="252" left="16" top="8852.789999999999" width="490" height="32" align-x="16" align-y="8873.589999999998" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">El contacto real de una bolsa flexible puede distribuir la fuerza de otra forma. El parche</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">de 100 N y su ancho son hipótesis que deben contrastarse.</c></f></p></text></region><region region-id="253" left="16" top="9110.68" width="490" height="20" align-x="16" align-y="9123.68" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="9"><b><c val="#687A88">SEDAC / P2.02 / MC01</c></b></f></p></text></region><region region-id="254" left="16" top="9136.68" width="490" height="28" align-x="16" align-y="9154.880000000001" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="14"><b><c val="#123B54">13. Refuerzos inferiores y puente del anclaje de hombro</c></b></f></p></text></region><region region-id="255" left="16" top="9170.68" width="330" height="48" align-x="16" align-y="9201.880000000001" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="#F0F6FC" tag="br"><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">br</ml:id><ml:apply><ml:mult/><ml:real>20</ml:real><ml:id xml:space="preserve">mm</ml:id></ml:apply></ml:define></math></region><region region-id="256" left="355" top="9170.68" width="150" height="48" align-x="355" align-y="9201.880000000001" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval