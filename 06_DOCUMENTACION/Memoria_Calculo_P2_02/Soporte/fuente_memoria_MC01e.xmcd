	<regions><region region-id="1" left="16" top="16.0" width="490" height="20" align-x="16" align-y="29.0" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="9"><b><c val="#687A88">SEDAC / P2.02 / MC01</c></b></f></p></text></region><region region-id="2" left="16" top="42.0" width="490" height="28" align-x="16" align-y="60.2" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="14"><b><c val="#123B54">1. Alcance y escenario de carga</c></b></f></p></text></region><region region-id="3" left="16" top="76.0" width="490" height="18" align-x="16" align-y="87.7" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="9"><c val="#687A88">Memoria editable en Mathcad clásico. Diseño de referencia: P2.02, 15/10/2026.</c></f></p></text></region><region region-id="4" left="16" top="100.0" width="490" height="32" align-x="16" align-y="120.8" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">Se estudia un sistema auxiliar para apoyar y estabilizar una bomba de espalda. Se revisan</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">rieles, cuna, cartelas, anclajes y uniones con modelos analíticos simplificados.</c></f></p></text></region><region region-id="5" left="16" top="138.0" width="490" height="45" align-x="16" align-y="167.25" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#8A4A12">Las entradas azules son hipótesis de prediseño. La bomba real, el arnés, la temperatura y el</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#8A4A12">espectro de fatiga siguen pendientes. Un margen calculado no acredita la seguridad del</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#8A4A12">conjunto.</c></f></p></text></region><region region-id="6" left="16" top="189.0" width="330" height="48" align-x="16" align-y="220.2" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="#F0F6FC" tag="Mass"><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">Mass</ml:id><ml:apply><ml:mult/><ml:real>25</ml:real><ml:id xml:space="preserve">kg</ml:id></ml:apply></ml:define></math></region><region region-id="7" left="355" top="189.0" width="150" height="48" align-x="355" align-y="220.2" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_Mass"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">Mass</ml:id><ml:unitOverride><ml:id xml:space="preserve">kg</ml:id></ml:unitOverride></ml:eval></math></region><region region-id="8" left="16" top="241.0" width="330" height="48" align-x="16" align-y="272.2" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="#F0F6FC" tag="grav"><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">grav</ml:id><ml:apply><ml:div/><ml:apply><ml:mult/><ml:real>9.81</ml:real><ml:id xml:space="preserve">m</ml:id></ml:apply><ml:apply><ml:pow/><ml:id xml:space="preserve">s</ml:id><ml:real>2</ml:real></ml:apply></ml:apply></ml:define></math></region><region region-id="9" left="355" top="241.0" width="150" height="48" align-x="355" align-y="272.2" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_grav"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">grav</ml:id><ml:unitOverride><ml:apply><ml:div/><ml:id xml:space="preserve">m</ml:id><ml:apply><ml:pow/><ml:id xml:space="preserve">s</ml:id><ml:real>2</ml:real></ml:apply></ml:apply></ml:unitOverride></ml:eval></math></region><region region-id="10" left="16" top="293.0" width="330" height="48" align-x="16" align-y="324.2" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="#F0F6FC" tag="av"><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">av</ml:id><ml:real>3</ml:real></ml:define></math></region><region region-id="11" left="355" top="293.0" width="150" height="48" align-x="355" align-y="324.2" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_av"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">av</ml:id></ml:eval></math></region><region region-id="12" left="16" top="345.0" width="330" height="48" align-x="16" align-y="376.2" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="#F0F6FC" tag="ah"><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">ah</ml:id><ml:real>1</ml:real></ml:define></math></region><region region-id="13" left="355" top="345.0" width="150" height="48" align-x="355" align-y="376.2" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_ah"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">ah</ml:id></ml:eval></math></region><region region-id="14" left="16" top="397.0" width="330" height="48" align-x="16" align-y="428.2" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="#F0F6FC" tag="eta"><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">eta</ml:id><ml:real>0.7</ml:real></ml:define></math></region><region region-id="15" left="355" top="397.0" width="150" height="48" align-x="355" align-y="428.2" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_eta"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">eta</ml:id></ml:eval></math></region><region region-id="16" left="16" top="449.0" width="330" height="48" align-x="16" align-y="480.2" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="Fv"><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">Fv</ml:id><ml:apply><ml:mult/><ml:apply><ml:mult/><ml:id xml:space="preserve">Mass</ml:id><ml:id xml:space="preserve">grav</ml:id></ml:apply><ml:id xml:space="preserve">av</ml:id></ml:apply></ml:define></math></region><region region-id="17" left="355" top="449.0" width="150" height="48" align-x="355" align-y="480.2" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_Fv"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">Fv</ml:id><ml:unitOverride><ml:id xml:space="preserve">N</ml:id></ml:unitOverride></ml:eval></math></region><region region-id="18" left="16" top="501.0" width="330" height="48" align-x="16" align-y="532.2" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="Fh"><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">Fh</ml:id><ml:apply><ml:mult/><ml:apply><ml:mult/><ml:id xml:space="preserve">Mass</ml:id><ml:id xml:space="preserve">grav</ml:id></ml:apply><ml:id xml:space="preser