false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#8A4A12">Kt y Kslot son amplificaciones provisionales: no son factores de concentración determinados</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#8A4A12">por FEA. El margen objetivo es una decisión del proyecto.</c></f></p></text></region><region region-id="66" left="16" top="2289.67" width="490" height="20" align-x="16" align-y="2302.67" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="9"><b><c val="#687A88">SEDAC / P2.02 / MC01</c></b></f></p></text></region><region region-id="67" left="16" top="2315.67" width="490" height="28" align-x="16" align-y="2333.87" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="14"><b><c val="#123B54">4. Propiedades exactas de la sección redondeada</c></b></f></p></text></region><region region-id="68" left="16" top="2349.67" width="490" height="32" align-x="16" align-y="2370.4700000000003" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">Se resta el contorno interior del exterior, con radios ro = 2t y ri = t. Las funciones</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">siguientes permiten cambiar b, d y t manteniendo las unidades.</c></f></p></text></region><region region-id="69" left="16" top=