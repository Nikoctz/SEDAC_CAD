		<region region-id="10" left="18" top="909" width="489.75" height="11.25" align-x="18" align-y="918" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto">
			<text use-page-width="false" push-down="false" lock-width="true">
