		<region region-id="378" left="18" top="10797" width="112.5" height="12.75" align-x="48.75" align-y="10806" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="z_D24">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve">z_D24</ml:id>
					<ml:apply>
						<ml:id xml:space="preserve">z_sec</ml:id>
						<ml:sequence>
