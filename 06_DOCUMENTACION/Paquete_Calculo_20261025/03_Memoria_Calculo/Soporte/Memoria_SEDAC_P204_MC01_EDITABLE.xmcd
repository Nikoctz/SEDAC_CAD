		</region>
		<region region-id="7" left="18" top="837" width="489.75" height="11.25" align-x="18" align-y="846" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto">
			<text use-page-width="false" push-down="false" lock-width="true">
