						<c val="#253746">
							<sp count="3"/>L_canal<sp count="2"/>[mm]<sp count="2"/>-<sp count="2"/>Largo del canal vertical, de la punta de arriba a la de abajo.</c>
					</f>
				</p>
			</text>
			<rendering item-idref="8"/>
		</region>
		<region region-id="9" left="18" top="885" width="489.75" height="11.25" align-x="18" align-y="894" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto">
			<text use-page-width="false" push-down="false" lock-width="true">
