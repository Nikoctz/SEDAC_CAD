		<region region-id="11" left="18" top="933" width="489.75" height="11.25" align-x="18" align-y="942" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="9">
						<c val="#253746">
							<sp count="3"/>t_nom<sp count="2"/>[mm]<sp count="2"/>-<sp count="2"/>Espesor nominal de la pared del canal, tal como se mecaniza.</c>
					</f>
				</p>
			</text>
			<rendering item-idref="11"/>
		</region>
		<region region-id="12" left="18" top="963" width="489.75" height="22.5" align-x="18" align-y="972" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="9">
						<c val="#253746">
