		<region region-id="34" left="18" top="1647" width="489.75" height="22.5" align-x="18" align-y="1656" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="9">
						<c val="#253746">
							<sp count="3"/>cierre_residual<sp count="2"/>[N]<sp count="2"/>-<sp count="2"/>Cuanta precarga queda despues de absorber la traccion de la</c>
					</f>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="9">
						<c val="#253746">union.</c>
					</f>
				</p>
			</text>
			<rendering item-idref="37"/>
		</region>
		<region region-id="35" left="18" top="1677" width="489.75" height="11.25" align-x="18" align-y="1686" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="9">
						<c val="#253746">
							<sp count="3"/>masa_CAD<sp count="2"/>[kg]<sp count="2"/>-<sp count="2"/>Masa de la parte rigida, medida en Inventor sobre el modelo entregado.</c>
					</f>
				</p>
			</text>
			<rendering item-idref="38"/>
		</region>
		<region region-id="36" left="18" top="1707" width="489.75" height="22.5" align-x="18" align-y="1716" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="9">
						<c val="#253746">
							<sp count="3"/>masa_presupuesto<sp count="2"/>[kg]<sp count="2"/>-<sp count="2"/>Masa del sistema sin bomba ni agua, contando las reservas de</c>
					</f>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="9">
						<c val="#253746">textiles.</c>
					</f>
				</p>
			</text>
			<rendering item-idref="39"/>
		</region>
		<region region-id="37" left="18" top="1743" width="489.75" height="22.5" align-x="18" align-y="1752" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="9">
						<c val="#253746">
							<sp count="3"/>bajo_cabeza, saliente<sp count="2"/>[mm]<sp count="2"/>-<sp count="2"/>Apilado de la union por debajo de la cabeza del tornillo,</c>
					</f>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="9">
						<c val="#253746">y cuanto sobra de tornillo.</c>
					</f>
				</p>
			</text>
			<rendering item-idref="40"/>
		</region>
		<region region-id="41" left="18" top="1832.25" width="489.75" height="312" align-x="18" align-y="1842" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#253746">CRIBado o filtro de prediseño: una lista de comprobaciones que descarta las formas de fallo</c>
					</f>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#253746">con poco margen. Es una criba, no una certificacion: si un margen sale bajo, el diseño se</c>
					</f>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#253746">revisa; si todos salen bien, todavia no se ha probado nada.</c>
					</f>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#253746">margen o factor de seguridad: cuantas veces la resistencia disponible supera a la que pide</c>
					</f>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#253746">la carga. Un margen de 2,25 significa que la pieza aguanta 2,25 veces la carga de calculo.</c>
					</f>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<c val="#253746">
						<f family="Arial" charset="0" size="10">modo que gobierna: la forma de fallo que deja menos margen. Si el margen lo fija el pandeo</f>
					</c>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<c val="#253746">
						<f family="Arial" charset="0" size="10">local de las alas, significa que el punto debil del canal es que las alas se doblen hacia</f>
					</c>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#253746">dentro, y no que se rompan.</c>
					</f>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#253746">envolvente de momento: no se calcula un unico caso de carga, sino el peor de una familia de</c>
					</f>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#253746">casos alternativos (el momento puesto en un extremo o en el otro, y la fuerza horizontal en</c>
					</f>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<c val="#253746">
						<f family="Arial" charset="0" size="10">cualquier punto de la luz). Por eso el resultado es un maximo, no un valor unico.</f>
					</c>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<c val="#253746">
						<f family="Arial" charset="0" size="10">pandeo: que una pieza se deforme por el efecto de una carga de compresion. El pandeo local</f>
					</c>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<c val="#253746">
						<f family="Arial" charset="0" size="10">ocurre dentro de la pieza (las alas del canal formando una onda) y el pandeo global, cuando</f>
					</c>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<c val="#253746">
						<f family="Arial" charset="0" size="10">la pieza entera se curva como una barra.</f>
					</c>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#253746">precarga: el apriete del tornillo. En una union precargada las piezas no se mueven mientras</c>
					</f>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<c val="#253746">
						<f family="Arial" charset="0" size="10">la carga de uso es pequeña, y por eso el reparto de fuerzas depende de la rigidez relativa</f>
					</c>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<c val="#253746">
						<f family="Arial" charset="0" size="10">de las piezas, no solo de sus resistencias.</f>
					</c>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<c val="#253746">
						<f family="Arial" charset="0" size="10">apilamiento axial: la suma de los espesores que el tornillo tiene que atravesar. Si el</f>
					</c>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<c val="#253746">
						<f family="Arial" charset="0" size="10">apilamiento es mayor que el tornillo, no monta; si es menor, sobra longitud, y esa sobra hay</f>
					</c>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#253746">que controlarla.</c>
					</f>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#253746">holgura axial: el espacio entre dos piezas que se tocan en la direccion del tornillo. Con</c>
					</f>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#253746">cero holgura, cualquier variacion de fabricacion hace que las piezas se interfieran o que</c>
					</f>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#253746">dejen de apoyar; por eso hay que cerrar la cadena de tolerancias con medidas reales.</c>
					</f>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#253746">resistencia frente a rigidez: la resistencia dice cuanto aguanta; la rigidez, cuanto se</c>
					</f>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#253746">deforma. Un material mas rgido puede ser mas pesado y ese es el compromiso central de este</c>
					</f>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<c val="#253746">
						<f family="Arial" charset="0" size="10">prototipo.</f>
					</c>
				</p>
			</text>
			<rendering item-idref="41"/>
		</region>
		<region region-id="42" left="18" top="2295" width="489.75" height="11.25" align-x="18" align-y="2304" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="9">
						<b>
							<c val="#687a88">SEDAC / P2.04-P2.05 / MC01</c>
						</b>
					</f>
				</p>
			</text>
			<rendering item-idref="42"/>
		</region>
		<region region-id="43" left="18" top="2321.25" width="489.75" height="15.75" align-x="18" align-y="2334" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="14">
						<b>
							<c val="#123b54">1. Alcance, unidades y estados de los datos</c>
						</b>
					</f>
				</p>
			</text>
			<rendering item-idref="43"/>
		</region>
		<region region-id="44" left="18" top="2361" width="489.75" height="22.5" align-x="18" align-y="2370" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="9">
						<c val="#687a88">Base P2.04 vigente, parametrizacion P2.05 abierta. Motor de calculo: Mathcad 15 (XMCD</c>
					</f>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="9">
						<c val="#687a88">clasico).</c>
					</f>
				</p>
			</text>
			<rendering item-idref="44"/>
		</region>
		<region region-id="45" left="18" top="2516.25" width="489.75" height="192" align-x="18" align-y="2526" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#253746">QUE ES ESTE DOCUMENTO: una memoria de calculo de prediseno, editable, del prototipo SEDAC en</c>
					</f>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#253746">su geometria vigente P2.04, con la parametrizacion P2.05 y el mismo modelo analitico que el</c>
					</f>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#253746">cribado vigente del repositorio SEDAC_CAD. Sirve para recalcular el conjunto cuando se</c>
					</f>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#253746">incorporen mediciones reales y para decidir cambios de geometria, material y componentes.</c>
					</f>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#253746">QUE NO ES: no es validacion del prototipo. No hay ensayo, no hay FEA, no hay certificacion</c>
					</f>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<c val="#253746">
						<f family="Arial" charset="0" size="10">de material y no hay liberacion para uso con personas. Los factores de seguridad que se</f>
					</c>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<c val="#253746">
						<f family="Arial" charset="0" size="10">calculan son de prediseno y dependen de hipotesis de carga no medidas.</f>
					</c>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#253746">ESTADOS USADOS: HECHO = verificable con un archivo del repositorio o un comando. MEDIDO =</c>
					</f>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#253746">medido en instrumento, con registro. DATO DE FABRICANTE = declarado por el proveedor.</c>
					</f>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#253746">SUPUESTO = valor adoptado sin medir. HIPOTESIS = condicion aun no comprobada. CALCULADO =</c>
					</f>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<c val="#253746">
						<f family="Arial" charset="0" size="10">resultado de esta hoja. PENDIENTE = sin dato.</f>
					</c>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<c val="#253746">
						<f family="Arial" charset="0" size="10">UNIDADES: se trabaja en mm, N, MPa y kg. Las constantes de entrada llevan su unidad escrita</f>
					</c>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<c val="#253746">
						<f family="Arial" charset="0" size="10">para que el verificador dimensional de Mathcad actue. Los resultados se muestran en la</f>
					</c>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<c val="#253746">
						<f family="Arial" charset="0" size="10">unidad de lectura propia.</f>
					</c>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#253746">MEDIDAS DE LABORATORIO: no existen. Los simbolos que dependerian de ellas NO se definen;</c>
					</f>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<c val="#253746">
						<f family="Arial" charset="0" size="10">definirlos activa los bloques de verificacion que se describen en las ultimas paginas.</f>
					</c>
				</p>
			</text>
			<rendering item-idref="45"/>
		</region>
		<region region-id="46" left="18" top="2606.25" width="489.75" height="12" align-x="18" align-y="2616" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#253746">ORIGEN DE LOS DATOS DE ENTRADA (solo lectura del repositorio SEDAC_CAD):</c>
					</f>
				</p>
			</text>
			<rendering item-idref="46"/>
		</region>
		<region region-id="47" left="18" top="2632.5" width="489.75" height="9.75" align-x="18" align-y="2640" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="8">
						<c val="#687a88">01_CAD/Prototipo_P2/P2_05_20261019/PARAMETROS_P2_05.json</c>
					</f>
				</p>
			</text>
			<rendering item-idref="47"/>
		</region>
