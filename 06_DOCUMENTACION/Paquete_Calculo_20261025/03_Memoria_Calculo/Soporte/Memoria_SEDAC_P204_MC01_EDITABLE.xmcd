		<region region-id="374" left="18" top="10689" width="489.75" height="11.25" align-x="18" align-y="10698" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="9">
						<c val="#687a88">D-14 pide sensibilidad a los parametros inciertos antes de FEA, fatiga y pandeo.</c>
					</f>
				</p>
			</text>
			<rendering item-idref="374"/>
		</region>
		<region region-id="375" left="18" top="10713" width="489.75" height="11.25" align-x="18" align-y="10722" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="9">
						<c val="#687a88">Profundidad evaluada: D. Se mantienen el resto de entradas del caso base.</c>
					</f>
				</p>
