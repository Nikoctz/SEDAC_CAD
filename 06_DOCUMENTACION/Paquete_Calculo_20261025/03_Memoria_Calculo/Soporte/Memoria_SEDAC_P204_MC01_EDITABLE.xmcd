					<f family="Arial" charset="0" size="9">
						<c val="#687a88">Todos los simbolos que aparecen en las paginas siguientes, explicados en lenguaje sencillo.</c>
					</f>
				</p>
			</text>
			<rendering item-idref="7"/>
