		<region region-id="209" left="18" top="5708.25" width="489.75" height="48" align-x="18" align-y="5718" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#253746">La envolvente reune casos alternativos, no un unico diagrama de cargas simultaneas. La</c>
					</f>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#253746">funcion M_env se declara despues de las cargas porque usa M0, Q_lado y L_luz: en Mathcad una</c>
					</f>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#253746">funcion se evalua en el momento de declararse y no se resuelve si sus variables todavia no</c>
					</f>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#253746">existen.</c>
					</f>
				</p>
			</text>
			<rendering item-idref="209"/>
		</region>
		<region region-id="210" left="18" top="5762.25" width="279" height="27.75" align-x="64.5" align-y="5778" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="M_env">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:function>
						<ml:id xml:space="preserve">M_env</ml:id>
						<ml:boundVars>
							<ml:id xml:space="preserve">x</ml:id>
						</ml:boundVars>
					</ml:function>
					<ml:apply>
						<ml:plus/>
						<ml:apply>
							<ml:mult/>
							<ml:id xml:space="preserve">M0</ml:id>
							<ml:apply>
								<ml:id xml:space="preserve">max</ml:id>
								<ml:sequence>
									<ml:apply>
										<ml:minus/>
										<ml:real>1</ml:real>
										<ml:apply>
											<ml:div/>
											<ml:id xml:space="preserve">x</ml:id>
											<ml:id xml:space="preserve">L_luz</ml:id>
										</ml:apply>
									</ml:apply>
									<ml:apply>
										<ml:div/>
										<ml:id xml:space="preserve">x</ml:id>
										<ml:id xml:space="preserve">L_luz</ml:id>
									</ml:apply>
								</ml:sequence>
							</ml:apply>
						</ml:apply>
						<ml:apply>
							<ml:div/>
							<ml:apply>
								<ml:mult/>
								<ml:apply>
									<ml:mult/>
									<ml:id xml:space="preserve">Q_lado</ml:id>
									<ml:id xml:space="preserve">x</ml:id>
								</ml:apply>
								<ml:parens>
									<ml:apply>
										<ml:minus/>
										<ml:id xml:space="preserve">L_luz</ml:id>
										<ml:id xml:space="preserve">x</ml:id>
									</ml:apply>
								</ml:parens>
							</ml:apply>
							<ml:id xml:space="preserve">L_luz</ml:id>
						</ml:apply>
					</ml:apply>
				</ml:define>
			</math>
			<rendering item-idref="210"/>
		</region>
