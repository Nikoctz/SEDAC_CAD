o</ws:c></ws:b></ws:f></ws:p></ws:text></ws:region><ws:region region-id="196" left="16" top="5381.23" width="490" height="30" align-x="16" align-y="5400.73" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><ws:text use-page-width="false" push-down="false" lock-width="true"><ws:p style="Normal"><ws:f family="Arial" charset="0" size="9"><ws:c val="#687A88">Envolvente: momento unico alternado en un extremo y fuerza horizontal de posicion variable</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="9"><ws:c val="#687A88">en la luz.</ws:c></ws:f></ws:p></ws:text></ws:region><ws:region region-id="197" left="16" top="5417.23" width="330" height="40" align-x="16" align-y="5443.23" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="L_luz"><ws:math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">L_luz</ml:id><ml:apply><ml:minus /><ml:id xml:space="preserve">apoyo_hombro_y</ml:id><ml:id xml:space="preserve">apoyo_cinturon_y</ml:id></ml:apply></ml:define></ws:math></ws:region><ws:region region-id="198" left="355" top="5417.23" width="150" height="40" align-x="355" align-y="5443.23" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_L_luz"><ws:math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">L_luz</ml:id><ml:unitOverride><ml:id xml:space="preserve">mm</ml:id></ml:unitOverride></ml:eval></ws:math></ws:region><ws:region region-id="199" left="16" top="5461.23" width="330" height="40" align-x="16" align-y="5487.23" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="Fv"><ws:math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">Fv</ml:id><ml:apply><ml:mult /><ml:apply><ml:mult /><ml:id xml:space="preserve">m_total</ml:id><ml:id xml:s