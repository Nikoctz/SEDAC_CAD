gion region-id="454" left="16" top="12558.24" width="330" height="40" align-x="16" align-y="12584.24" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="sig_biax_D28"><ws:math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">sig_biax_D28</ml:id><ml:apply><ml:plus /><ml:id xml:space="preserve">sig_D28</ml:id><ml:apply><ml:div /><ml:apply><ml:mult /><ml:apply><ml:mult /><ml:id xml:space="preserve">K_borde</ml:id><ml:id xml:space="preserve">mlat</ml:id></ml:apply><ml:apply><ml:div /><ml:id xml:space="preserve">B</ml:id><ml:real>2</ml:real></ml:apply></ml:apply><ml:id xml:space="preserve">Ix_D28</ml:id></ml:apply></ml:apply></ml:define></ws:math></ws:region><ws:region region-id="455" left="355" top="12558.24" width="150" height="40" align-x="355" align-y="12584.24" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_sig_biax_D28"><ws:math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">sig_biax_D28</ml:id><ml:unitOverride><ml:id xml:space="preserve">MPa</ml:id></ml:unitOverride></ml:eval></ws:math></ws:region><ws:region region-id="456" left="16" top="12602.24" width="330" height="40" align-x="16" align-y="12628.24" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="tau_D28"><ws:math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">tau_D28</ml:id><ml:apply><ml:plus /><ml:apply><ml:div /><ml:apply><ml:mult /><ml:id xml:space="preserve">T</ml:id><ml:id xml:space="preserve">t_min</ml:id></ml:apply><ml:id xml:space="preserve">J_D28</ml:id></ml:apply><ml:apply><ml:div /><ml:id xml:space="preserve">Q_lado</ml:id><ml:id xml:space="preserve">A_D28</ml:id></ml:apply></ml:apply></ml:define></ws:math></ws:region><ws:region region-id="457" left="355" top="12602.24" width="150" height="40" align-x="355" align-y="12628.24" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_tau_D28"><ws:math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">tau_D28</ml:id><ml:unitOverride><ml:id xml:space="preserve">MPa</ml:id></ml:unitOverride></ml:eval></ws:math></ws:region><ws:region region-id="458" left="16" top="12646.24" width="330" height="40" align-x="16" align-y="12672.24" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="vm_D28"><ws:math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">vm_D28</ml:id><ml:apply><ml:sqrt /><ml:apply><ml:plus /><ml:apply><ml:pow /><ml:id xml:space="preserve">sig_biax_D28</ml:id><ml:real>2</ml:real></ml:apply><ml:apply><ml:mult /><ml:real>3</ml:real><ml:apply><ml:pow /><ml:id xml:space="preserve">tau_D28</ml:id><ml:real>2</ml:real></ml:apply></ml:apply></ml:apply></ml:apply></ml:define></ws:math></ws:region><ws:region region-id="459" left="355" top="12646.24" width="150" height="40" align-x="355" align-y="12672.24" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_vm_D28"><ws:math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">vm_D28</ml:id><ml:unitOverride><ml:id xml:space="preserve">MPa</ml:id></ml:unitOverride></ml:eval></ws:math></ws:region><ws:region region-id="460" left="16" top="12690.24" width="330" height="40" align-x="16" align-y="12716.24" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="sig_placa_D28"><ws:math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">sig_placa_D28</ml:id><ml:apply><ml:mult /><ml:apply><ml:div /><ml:apply><ml:mult /><ml:apply><ml:mult /><ml:real>0.43</ml:real><ml:apply><ml:pow /><ml:id xml:space="preserve">π</ml:id><ml:real>2</ml:real></ml:apply></ml:apply><ml:id xml:space="preserve">E_al</ml:id></ml:apply><ml:apply><ml:mult /><ml:real>12</ml:real><ml:parens><ml:apply><ml:minus /><ml:real>1</ml:real><ml:apply><ml:pow /><ml:id xml:space="preserve">nu</ml:id><ml:real>2</ml:real></ml:apply></ml:apply></ml:parens></ml:apply></ml:apply><ml:apply><ml:pow /><ml:parens><ml:apply><ml:div /><ml:id xml:space="preserve">t_min</ml:id><ml:parens><ml:apply><ml:minus /><ml:apply><ml:mult /><ml:real>28</ml:real><ml:id xml:space="preserve">mm</ml:id></ml:apply><ml:id xml:space="preserve">t_min</ml:id></ml:apply></ml:parens></ml:apply></ml:parens><ml:real>2</ml:real></ml:apply></ml:apply></ml:define></ws:math></ws:region><ws:region region-id="461" left="355" top="12690.24" width="150" height="40" align-x="355" align-y="12716.24" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_sig_placa_D28"><ws:math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">sig_placa_D28</ml:id><ml:unitOverride><ml:id xml:space="preserve">MPa</ml:id></ml:unitOverride></ml:eval></ws:math></ws:region><ws:region region-id="462" left="16" top="12734.24" width="330" height="40" align-x="16" align-y="12760.24" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="n_comb_D28"><ws:math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">n_comb_D28</ml:id><ml:apply><ml:div /><ml:id xml:space="preserve">Sy_al</ml:id><ml:id xml:space="preserve">vm_D28</ml:id></ml:apply></ml:define></ws:math></ws:region><ws:region region-id="463" left="355" top="12734.24" width="150" height="40" align-x="355" align-y="12760.24" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_n_comb_D28"><ws:math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">n_comb_D28</ml:id></ml:eval></ws:math></ws:region><ws:region region-id="464" left="16" top="12778.24" width="330" height="40" align-x="16" align-y="12804.24" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="n_local_D28"><ws:math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">n_local_D28</ml:id><ml:apply><ml:div /><ml:apply><ml:id xml:space="preserve">min</ml:id><ml:sequence><ml:id xml:space="preserve">Sy_al</ml:id><ml:id xml:space="preserve">sig_placa_D28</ml:id></ml:sequence></ml:apply><ml:id xml:space="preserve">vm_D28</ml:id></ml:apply></ml:define></ws:math></ws:region><ws:region region-id="465" left="355" top="12778.24" width="150" height="40" align-x="355" align-y="12804.24" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_n_local_D28"><ws:math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">n_local_D28</ml:id></ml:eval></ws:math></ws:region><ws:region region-id="466" left="16" top="12822.24" width="330" height="40" align-x="16" align-y="12848.24" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="n_caso_D28"><ws:math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">n_caso_D28</ml:id><ml:apply><ml:id xml:space="preserve">min</ml:id><ml:sequence><ml:id xml:space="preserve">n_comb_D28</ml:id><ml:id xml:space="preserve">n_local_D28</ml:id></ml:sequence></ml:apply></ml:define></ws:math></ws:region><ws:region region-id="467" left="355" top="12822.24" width="150" height="40" align-x="355" align-y="12848.24" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_n_caso_D28"><ws:math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">n_caso_D28</ml:id></ml:eval></ws:math></ws:region><ws:region region-id="468" left="16" top="12866.24" width="490" height="97" align-x="16" align-y="12929.29" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><ws:text use-page-width="false" push-down="false" lock-width="true"><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">Lectura: aumentar D reduce la tension combinada y tambien la tension critica elastica local</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">del ala. Un margen local mayor no demuestra mayor resistencia elastica al pandeo. El cambio</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">exige reevaluar la altura de mejilla y desplaza el reparto de cargas entre las uniones. El</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">caso base ya cumple el umbral con margen estrecho; cualquier reduccion de pared o de seccion</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">puede llevarla por debajo. La sensibilidad completa, incluyendo factores de carga, reparto y</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">excentricidad, se hace sobre las cifras medidas, no sobre hipotesis: por eso las entradas de</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">carga siguen marcadas como hipotesis.</ws:c></ws:f></ws:p></ws:text></ws:region><ws:region region-id="469" left="16" top="12900.13" width="490" height="20" align-x="16" align-y="12913.13" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><ws:text use-page-width="false" push-down="false" lock-width="true"><ws:p style="Normal"><ws:f family="Arial" charset="0" size="9"><ws:b><ws:c val="#687A88">SEDAC / P2.04-P2.05 / MC01</ws:c></ws:b></ws:f></ws:p></ws:text></ws:region><ws:region region-id="470" left="16" top="12926.13" width="490" height="28" align-x="16" align-y="12944.33" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><ws:text use-page-width="false" push-down="false" lock-width="true"><ws:p style="Normal"><ws:f family="Arial" charset="0" size="14"><ws:b><ws:c val="#123B54">13. Datos de laboratorio pendientes (simbolos NO definidos)</ws:c></ws:b></ws:f></ws:p></ws:text></ws:region><ws:region region-id="471" left="16" top="12960.13" width="490" height="18" align-x="16" align-y="12971.83" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><ws:text use-page-width="false" push-down="false" lock-width="true"><ws:p style="Normal"><ws:f family="Arial" charset="0" size="9"><ws:c val="#687A88">Definir estos simbolos activa los bloques de verificacion posterior.</ws:c></ws:f></ws:p></ws:text></ws:region><ws:region region-id="472" left="16" top="12984.13" width="490" height="201" align-x="16" align-y="13114.78" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><ws:text use-page-width="false" push-down="false" lock-width="true"><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">Simbolos que deben definirse cuando existan mediciones, con su unidad:</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">  m_bomba_vacia, m_bomba_llena   (kg)  masa de la bomba de espalda con y sin agua, con</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">manguera</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">  z_cg_bomba, x_cg_bomba, y_cg_bomba (mm) centro de masa de la bomba llena, medido</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">  m_arnes, z_cg_arnes (kg, mm)      masa y centro de masa del arnes con acolchado</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">  B_med, t_med (mm)                 ancho exterior y espesor real de pared de los canales</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">  L_casq_med (mm)                   longitud real de los casquillos ya ajustados</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">  ancho_cinta, esp_cinta (mm)       ancho y espesor real de las correas</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">  rigidez_correa (N/mm)             rigidez axial medida de la correa</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">  ancho_apoyo_hombro, ancho_apoyo_cinturon (mm)  zonas de apoyo efectiva</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">  recorrido_cinta (mm)              recorrido real de las cintas</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">  IMU_1, IMU_2, ... (datos de sensor) series de IMU crudas con su calibracion</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">Ninguno de estos valores se inventa ni se aproxima con ceros. Si un simbolo permanece</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">indefinido, cualquier expresion que lo use quedara marcada como error por Mathcad: esa es la</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">deteccion de entradas incompletas en el motor de calculo.</ws:c></ws:f></ws:p></ws:text></ws:region><ws:region region-id="473" left="16" top="13191.13" width="490" height="58" align-x="16" align-y="13228.83" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><ws:text use-page-width="false" push-down="false" lock-width="true"><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">Orden recomendado de incorporacion (D-14 y D-15): 1) masa y centro de masa reales de bomba y</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">arnes; 2) apoyos y zonas de contacto; 3) rigidez y recorrido de correas; 4) B, t y</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">longitudes reales de las piezas; 5) incorporar los datos de IMU para comparar la respuesta</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">medida contra la respuesta predicha.</ws:c></ws:f></ws:p></ws:text></ws:region><ws:region region-id="474" left="16" top="13658.02" width="490" height="20" align-x="16" align-y="13671.02" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><ws:text use-page-width="false" push-down="false" lock-width="true"><ws:p style="Normal"><ws:f family="Arial" charset="0" size="9"><ws:b><ws:c val="#687A88">SEDAC / P2.04-P2.05 / MC01</ws:c></ws:b></ws:f></ws:p></ws:text></ws:region><ws:region region-id="475" left="16" top="13684.02" width="490" height="28" align-x="16" align-y="13702.22" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><ws:text use-page-width="false" push-down="false" lock-width="true"><ws:p style="Normal"><ws:f family="Arial" charset="0" size="14"><ws:b><ws:c val="#123B54">14. Comparacion entre prediccion y ensayo</ws:c></ws:b></ws:f></ws:p></ws:text></ws:region><ws:region region-id="476" left="16" top="13718.02" width="490" height="30" align-x="16" align-y="13737.52" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><ws:text use-page-width="false" push-down="false" lock-width="true"><ws:p style="Normal"><ws:f family="Arial" charset="0" size="9"><ws:c val="#687A88">Plantilla de cotejo. Los campos de izquierda se llenan con la memoria; los de derecha, con</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="9"><ws:c val="#687A88">el ensayo.</ws:c></ws:f></ws:p></ws:text></ws:region><ws:region region-id="477" left="16" top="13754.02" width="490" height="214" align-x="16" align-y="13893.12" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><ws:text use-page-width="false" push-down="false" lock-width="true"><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">Magnitudes a cotejar tras un ensayo instrumentado:</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">  desplazamiento o flecha en el punto de apoyo        predicho por esta hoja   medido en</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">ensayo   diferencia</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">  inclinacion o giro del conjunto                        predicho                  medido</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">diferencia</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">  desplazamiento relativo bomba-arnes                    predicho                  medido</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">diferencia</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">  frecuencia propia del conjunto (ensayo de impacto)     no calculada             medido</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">-</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">  carga en correa en el punto de anclaje                 predicho por Tinterface   medido</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">con celda   diferencia</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">La prediccion exige un modelo dinamico valido: una IMU con acelerometro y giroscopio entrega</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">fuerza especifica y velocidad angular; no mide directamente fuerzas. Convertir aceleracion</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">en fuerza exige un modelo dinamico (masa, rigidez, amortiguamiento) y sus condiciones de</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">validez. La instrumentacion adicional de fuerza o tension es la que permite cerrar esa</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">cadena; sin ella, la IMU no valida la resistencia del prototipo.</ws:c></ws:f></ws:p></ws:text></ws:region><ws:region region-id="478" left="16" top="13974.02" width="490" height="45" align-x="16" align-y="14003.27" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><ws:text use-page-width="false" push-down="false" lock-width="true"><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">Criterio de aceptacion de la comparacion: PENDIENTE de acordar con el profesor de</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">biomecanica. Debe fijarse antes del ensayo piloto: tolerancia admisible, numero de</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">repeticiones y tratamiento de la dispersion.</ws:c></ws:f></ws:p></ws:text></ws:region><ws:region region-id="479" left="16" top="14415.91" width="490" height="20" align-x="16" align-y="14428.91" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><ws:text use-page-width="false" push-down="false" lock-width="true"><ws:p style="Normal"><ws:f family="Arial" charset="0" size="9"><ws:b><ws:c val="#687A88">SEDAC / P2.04-P2.05 / MC01</ws:c></ws:b></ws:f></ws:p></ws:text></ws:region><ws:region region-id="480" left="16" top="14441.91" width="490" height="28" align-x="16" align-y="14460.11" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><ws:text use-page-width="false" push-down="false" lock-width="true"><ws:p style="Normal"><ws:f family="Arial" charset="0" size="14"><ws:b><ws:c val="#123B54">15. Limites de uso de esta memoria</ws:c></ws:b></ws:f></ws:p></ws:text></ws:region><ws:region region-id="481" left="16" top="14475.91" width="490" height="18" align-x="16" align-y="14487.61" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><ws:text use-page-width="false" push-down="false" lock-width="true"><ws:p style="Normal"><ws:f family="Arial" charset="0" size="9"><ws:c val="#687A88">Lo que la hoja permite y lo que no.</ws:c></ws:f></ws:p></ws:text></ws:region><ws:region region-id="482" left="16" top="14499.91" width="490" height="136" align-x="16" align-y="14588.31" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><ws:text use-page-width="false" push-down="false" lock-width="true"><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">PERMITE: recalcular el cribado al cambiar geometria, material, uniones o cargas; obtener el</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">factor de seguridad de cada modo con la misma hipotesis; ver la sensibilidad a la</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">profundidad; y dejar registro de que valores se usaron.</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">NO PERMITE: declarar seguridad, resistencia, comodidad o cumplimiento normativo; extrapolar</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">a personas sin ensayo autorizado; sustituir una FEA de detalle; sustituir la medicion de la</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">bomba, el arnes, las correas o el contacto.</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">Advertencia sobre la version: esta hoja reproduce el modelo del cribado vigente del</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">repositorio SEDAC_CAD con la geometria P2.04. Si el generador del CAD cambia, hay que</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">regenerar, volver a medir la masa en Inventor y recalcular esta hoja; la coherencia entre</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">CAD, memoria y documentos no es automatica.</ws:c></ws:f></ws:p></ws:text></ws:region></ws:regions></ws:worksheet>