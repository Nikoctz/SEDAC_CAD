f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">limite de fluencia. El pandeo lateral torsional es ideal y no acredita pandeo distorsional</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">ni alabeo. Ninguno de estos modos sustituye un analisis de detalle con las geometrias reales</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">y las ranuras.</ws:c></ws:f></ws:p></ws:text></ws:region><ws:region region-id="262" left="16" top="6837.01" width="490" height="20" align-x="16" align-y="6850.01" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><ws:text use-page-width="false" push-down="false" lock-width="true"><ws:p style="Normal"><ws:f family="Arial" charset="0" size="9"><ws:b><ws:c val="#687A88">SEDAC / P2.04-P2.05 / MC01</ws:c></ws:b></ws:f></ws:p></ws:text></ws:region><ws:region region-id="263" left="16" top="6863.01" width="490" height="28" align-x="16" align-y="6881.21" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><ws:text use-page-width="false" push-down="false" lock-width="true"><ws:p style="Normal"><ws:f family="Arial" charset="0" size="14"><ws:b><ws:c val="#123B54">7. Uniones: pasador, casquillo, arandelas y perno M5</ws:c></ws:b></ws:f></ws:p></ws:text></ws:region><ws:region region-id="264" left="16" top="6897.01" width="490" height="18" align-x="16" align-y="6908.71" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><ws:text use-page-width="false" push-down="false" lock-width="true"><ws:p style="Normal"><ws:f family="Arial" charset="0" size="9"><ws:c val="#687A88">Cargas de union deducidas de la envolvente; precarga de estudio hipotetica.</ws:c></ws:f></ws:p></ws:text></ws:region><ws:region region-id="265" left="