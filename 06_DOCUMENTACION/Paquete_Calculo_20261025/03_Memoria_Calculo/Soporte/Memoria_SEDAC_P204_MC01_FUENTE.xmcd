:plus /><ml:real>1</ml:real><ml:id xml:space="preserve">nu</ml:id></ml:apply></ml:parens></ml:apply></ml:apply></ml:define></ws:math></ws:region><ws:region region-id="226" left="355" top="6110.23" width="150" height="40" align-x="355" align-y="6136.23" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_GG"><ws:math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">GG</ml:id><ml:unitOverride><ml:id xml:space="preserve">MPa</ml:id></ml:unitOverride></ml:eval></ws:math></ws:region><ws:region region-id="227" left="16" top="6154.23" width="490" height="45" align-x="16" align-y="6183.48" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><ws:text use-page-width="false" push-down="false" lock-width="true"><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">El maximo se evalua sobre la misma malla de 801 puntos que usa el cribado vigente del</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">repositorio: se calcula el punto critico continuo y se comparan los dos puntos de malla</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">vecinos, de modo que el resultado coincide con el barrido numerico sin depender de vectores.</ws:c></ws:f></ws:p></ws:text></ws:region><ws:region region-id="228" left="16" top="6079.12" width="490" height="20" align-x="16" align-y="6092.12" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><ws:text use-page-width="false" push-down="false" lock-width="true"><ws:p style="Normal"><ws:f family="Arial" charset="0" size="9"><ws:b><ws:c val="#687A88">SEDAC / P2.04-P2.05 / MC01</ws:c></ws:b></ws:f></ws:p></ws:text></ws:region><ws:region region-id="229" left="16" top="6105.12" width="490" height="28" align-x="16