ath></ws:region><ws:region region-id="345" left="16" top="8580.79" width="330" height="44" align-x="16" align-y="8609.39" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="giro"><ws:math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">giro</ml:id><ml:apply><ml:div /><ml:apply><ml:mult /><ml:apply><ml:div /><ml:apply><ml:mult /><ml:id xml:space="preserve">T</ml:id><ml:id xml:space="preserve">L_luz</ml:id></ml:apply><ml:apply><ml:mult /><ml:id xml:space="preserve">GG</ml:id><ml:id xml:space="preserve">J_min</ml:id></ml:apply></ml:apply><ml:real>180</ml:real></ml:apply><ml:id xml:space="preserve">π</ml:id></ml:apply></ml:define></ws:math></ws:region><ws:region region-id="346" left="355" top="8580.79" width="150" height="44" align-x="355" align-y="8609.39" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_giro"><ws:math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">giro</ml:id><ml:unitOverride><ml:id xml:space="preserve">grados</ml:id></ml:unitOverride></ml:eval></ws:math></ws:region><ws:region region-id="347" left="16" top="8628.79" width="330" height="44" align-x="16" align-y="8657.39" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="cierre_residual"><ws:math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">cierre_residual</ml:id><ml:apply><ml:minus /><ml:apply><ml:mult /><ml:real>0.75</ml:real><ml:id xml:space="preserve">precarga</ml:id></ml:apply><ml:apply><ml:mult /><ml:real>0.8</ml:real><ml:id xml:space="preserve">R</ml:id></ml:apply></ml:apply></ml:define></ws:math></ws:region><ws:region region-id="348" left="355" top="8628.79" width="150" height="44" align-x="355" align-y="8657.39" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_cierre_residual"><ws:math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">cierre_residual</ml:id><ml:unitOverride><ml:id xml:space="preserve">N</ml:id></ml:unitOverride></ml:eval></ws:math></ws:region><ws:region region-id="349" left="16" top="8676.79" width="490" height="45" align-x="16" align-y="8706.04" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><ws:text use-page-width="false" push-down="false" lock-width="true"><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">El cribado es un filtro de prediseno, no una verificacion de seguridad. No cubre fatiga,</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">pandeo distorsional, FEA de detalle, contacto real, abrasion, ergonomia ni liberacion de</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">emergencia.</ws:c></ws:f></ws:p></ws:text></ws:region><ws:region region-id="350" left="16" top="9110.68" width="490" height="20" align-x="16" align-y="9123.68" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><ws:text use-page-width="false" push-down="false" lock-width="true"><ws:p style="Normal"><ws:f family="Arial" charset="0" size="9"><ws:b><ws:c val="#687A88">SEDAC / P2.04-P2.05 / MC01</ws:c></ws:b></ws:f></ws:p></ws:text></ws:region><ws:region region-id="351" left="16" top="9136.68" width="490" height="28" align-x="16" align-y="9154.88" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><ws:text use-page-width="false" push-down="false" lock-width="true"><ws:p style="Normal"><ws:f family="Arial" charset="0" size="14"><ws:b><ws:c val="#123B54">10. Masa del conjunto y presupuesto</ws:c></ws:b></ws:f></ws:p></ws:text></ws:region><ws:region region-id="352" left="16" top="9170.68" width="490" height="18" align-x="16" align-y="9182.38" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><ws:text use-page-width="false" push-down="false" lock-width="true"><ws:p style="Normal"><ws:f family="Arial" charset="0" size="9"><ws:c val="#687A88">Masa medida en el CAD de P2.04. La bomba y el arnes real siguen sin medir.</ws:c></ws:f></ws:p></ws:text></ws:region><ws:region region-id="353" left="16" top="9194.68" width="330" height="44" align-x="16" align-y="9223.28" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="masa_presupuesto"><ws:math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">masa_presupuesto</ml:id><ml:apply><ml:plus /><ml:apply><ml:plus /><ml:id xml:space="preserve">masa_CAD</ml:id><ml:id xml:space="preserve">reserva_textil</ml:id></ml:apply><ml:id xml:space="preserve">reserva_adicional</ml:id></ml:apply></ml:define></ws:math></ws:region><ws:region region-id="354" left="355" top="9194.68" width="150" height="44" align-x="355" align-y="9223.28" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_masa_presupuesto"><ws:math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">masa_presupuesto</ml:id><ml:unitOverride><ml:id xml:space="preserve">kg</ml:id></ml:unitOverride></ml:eval></ws:math></ws:region><ws:region region-id="355" left="16" top="9242.68" width="330" height="44" align-x="16" align-y="9271.28" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="masa_brecha_2kg"><ws:math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">masa_brecha_2kg</ml:id><ml:apply><ml:minus /><ml:id xml:space="preserve">masa_presupuesto</ml:id><ml:apply><ml:mult /><ml:real>2</ml:real><ml:id xml:space="preserve">kg</ml:id></ml:apply></ml:apply></ml:define></ws:math></ws:region><ws:region region-id="356" left="355" top="9242.68" width="150" height="44" align-x="355" align-y="9271.28" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_masa_brecha_2kg"><ws:math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">masa_brecha_2kg</ml:id><ml:unitOverride><ml:id xml:space="preserve">kg</ml:id></ml:unitOverride></ml:eval></ws:math></ws:region><ws:region region-id="357" left="16" top="9290.68" width="330" height="44" align-x="16" align-y="9319.28" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="paquete"><ws:math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">paquete</ml:id><ml:apply><ml:plus /><ml:id xml:space="preserve">B</ml:id><ml:apply><ml:mult /><ml:real>2</ml:real><ml:id xml:space="preserve">esp_mejilla</ml:id></ml:apply></ml:apply></ml:define></ws:math></ws:region><ws:region region-id="358" left="355" top="9290.68" width="150" height="44" align-x="355" align-y="9319.28" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_paquete"><ws:math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">paquete</ml:id><ml:unitOverride><ml:id xml:space="preserve">mm</ml:id></ml:unitOverride></ml:eval></ws:math></ws:region><ws:region region-id="359" left="16" top="9338.68" width="490" height="58" align-x="16" align-y="9376.38" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><ws:text use-page-width="false" push-down="false" lock-width="true"><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">La masa de 1,442328 kg es rigida + protectores, medida por MassProperties en Inventor. El</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">presupuesto de 2,212328 kg anade la reserva textil de 0,65 kg y 0,12 kg de reserva</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">adicional. NO incluye la bomba ni el agua. Los 25 kg del caso de carga son hipotesis de</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">carga, no masa de la estructura: no deben agregarse a la masa del CAD.</ws:c></ws:f></ws:p></ws:text></ws:region><ws:region region-id="360" left="16" top="9868.57" width="490" height="20" align-x="16" align-y="9881.57" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><ws:text use-page-width="false" push-down="false" lock-width="true"><ws:p style="Normal"><ws:f family="Arial" charset="0" size="9"><ws:b><ws:c val="#687A88">SEDAC / P2.04-P2.05 / MC01</ws:c></ws:b></ws:f></ws:p></ws:text></ws:region><ws:region region-id="361" left="16" top="9894.57" width="490" height="28" align-x="16" align-y="9912.77" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><ws:text use-page-width="false" push-down="false" lock-width="true"><ws:p style="Normal"><ws:f family="Arial" charset="0" size="14"><ws:b><ws:c val="#123B54">11. Apilamiento axial de la union y cadena de holguras</ws:c></ws:b></ws:f></ws:p></ws:text></ws:region><ws:region region-id="362" left="16" top="9928.57" width="490" height="18" align-x="16" align-y="9940.27" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><ws:text use-page-width="false" push-down="false" lock-width="true"><ws:p style="Normal"><ws:f family="Arial" charset="0" size="9"><ws:c val="#687A88">Revision de la longitud nominal del tornillo y de la holgura axial del casquillo.</ws:c></ws:f></ws:p></ws:text></ws:region><ws:region region-id="363" left="16" top="9952.57" width="330" height="44" align-x="16" align-y="9981.17" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="L_casq"><ws:math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">L_casq</ml:id><ml:apply><ml:minus /><ml:id xml:space="preserve">B</ml:id><ml:apply><ml:mult /><ml:real>2</ml:real><ml:id xml:space="preserve">t_nom</ml:id></ml:apply></ml:apply></ml:define></ws:math></ws:region><ws:region region-id="364" left="355" top="9952.57" width="150" height="44" align-x="355" align-y="9981.17" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_L_casq"><ws:math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">L_casq</ml:id><ml:unitOverride><ml:id xml:space="preserve">mm</ml:id></ml:unitOverride></ml:eval></ws:math></ws:region><ws:region region-id="365" left="16" top="10000.57" width="330" height="44" align-x="16" align-y="10029.17" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="holgura_axial"><ws:math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">holgura_axial</ml:id><ml:apply><ml:minus /><ml:apply><ml:minus /><ml:id xml:space="preserve">B</ml:id><ml:apply><ml:mult /><ml:real>2</ml:real><ml:id xml:space="preserve">t_nom</ml:id></ml:apply></ml:apply><ml:id xml:space="preserve">L_casq</ml:id></ml:apply></ml:define></ws:math></ws:region><ws:region region-id="366" left="355" top="10000.57" width="150" height="44" align-x="355" align-y="10029.17" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_holgura_axial"><ws:math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">holgura_axial</ml:id><ml:unitOverride><ml:id xml:space="preserve">mm</ml:id></ml:unitOverride></ml:eval></ws:math></ws:region><ws:region region-id="367" left="16" top="10048.57" width="330" height="44" align-x="16" align-y="10077.17" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="bajo_cabeza"><ws:math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">bajo_cabeza</ml:id><ml:apply><ml:plus /><ml:apply><ml:plus /><ml:id xml:space="preserve">paquete</ml:id><ml:apply><ml:mult /><ml:real>2</ml:real><ml:id xml:space="preserve">arandela_esp</ml:id></ml:apply></ml:apply><ml:id xml:space="preserve">altura_tuerca</ml:id></ml:apply></ml:define></ws:math></ws:region><ws:region region-id="368" left="355" top="10048.57" width="150" height="44" align-x="355" align-y="10077.17" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_bajo_cabeza"><ws:math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">bajo_cabeza</ml:id><ml:unitOverride><ml:id xml:space="preserve">mm</ml:id></ml:unitOverride></ml:eval></ws:math></ws:region><ws:region region-id="369" left="16" top="10096.57" width="330" height="44" align-x="16" align-y="10125.17" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="saliente"><ws:math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">saliente</ml:id><ml:apply><ml:minus /><ml:id xml:space="preserve">longitud_tornillo</ml:id><ml:id xml:space="preserve">bajo_cabeza</ml:id></ml:apply></ml:define></ws:math></ws:region><ws:region region-id="370" left="355" top="10096.57" width="150" height="44" align-x="355" align-y="10125.17" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_saliente"><ws:math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">saliente</ml:id><ml:unitOverride><ml:id xml:space="preserve">mm</ml:id></ml:unitOverride></ml:eval></ws:math></ws:region><ws:region region-id="371" left="16" top="10144.57" width="490" height="123" align-x="16" align-y="10224.52" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><ws:text use-page-width="false" push-down="false" lock-width="true"><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">La longitud nominal de un tornillo de cabeza cilindrica se mide desde debajo de la cabeza</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">hasta la punta: la altura de la cabeza no se descuenta del largo disponible. El apilamiento</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">bajo cabeza hasta la cara exterior de la tuerca es paquete + 2 arandelas + tuerca; la</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">diferencia con la longitud nominal es la saliente geometrica. La holgura axial del casquillo</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">sale de la definicion vigente L_casq = B - 2t, es decir, ocupa exactamente el ancho</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">interior: con t &gt; 3 mm aparece holgura negativa. La funcion documentada del casquillo es</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">actuar como tope de compresion y evitar aplastar las alas durante el apriete; acortarlo</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">cambia esa funcion y no se justifica sin cerrar la cadena de tolerancias con medidas reales</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">de B y t.</ws:c></ws:f></ws:p></ws:text></ws:region><ws:region region-id="372" left="16" top="10626.46" width="490" height="20" align-x="16" align-y="10639.46" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><ws:text use-page-width="false" push-down="false" lock-width="true"><ws:p style="Normal"><ws:f family="Arial" charset="0" size="9"><ws:b><ws:c val="#687A88">SEDAC / P2.04-P2.05 / MC01</ws:c></ws:b></ws:f></ws:p></ws:text></ws:region><ws:region region-id="373" left="16" top="10652.46" width="490" height="28" align-x="16" align-y="10670.66" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><ws:text use-page-width="false" push-down="false" lock-width="true"><ws:p style="Normal"><ws:f family="Arial" charset="0" size="14"><ws:b><ws:c val="#123B54">12. Sensibilidad de la profundidad del canal (caso D24)</ws:c></ws:b></ws:f></ws:p></ws:text></ws:region><ws:region region-id="374" left="16" top="10686.46" width="490" height="18" align-x="16" align-y="10698.16" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><ws:text use-page-width="false" push-down="false" lock-width="true"><ws:p style="Normal"><ws:f family="Arial" charset="0" size="9"><ws:c val="#687A88">D-14 pide sensibilidad a los parametros inciertos antes de FEA, fatiga y pandeo.</ws:c></ws:f></ws:p></ws:text></ws:region><ws:region region-id="375" left="16" top="10710.46" width="490" height="18" align-x="16" align-y="10722.16" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><ws:text use-page-width="false" push-down="false" lock-width="true"><ws:p style="Normal"><ws:f family="Arial" charset="0" size="9"><ws:c val="#687A88">Profundidad evaluada: D. Se mantienen el resto de entradas del caso base.</ws:c></ws:f></ws:p></ws:text></ws:region><ws:region region-id="376" left="16" top="10734.46" width="330" height="40" align-x="16" align-y="10760.46" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="A_D24"><ws:math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">A_D24</ml:id><ml:apply><ml:id xml:space="preserve">A_sec</ml:id><ml:sequence><ml:id xml:space="preserve">B</ml:id><ml:id xml:space="preserve">D</ml:id><ml:id xml:space="preserve">t_min</ml:id></ml:sequence></ml:apply></ml:define></ws:math></ws:region><ws:region region-id="377" left="355" top="10734.46" width="150" height="40" align-x="355" align-y="10760.46" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_A_D24"><ws:math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">A_D24</ml:id><ml:unitOverride><ml:apply><ml:pow /><ml:id xml:space="preserve">mm</ml:id><ml:real>2</ml:real></ml:apply></ml:unitOverride></ml:eval></ws:math></ws:region><ws:region region-id="378" left="16" top="10778.46" width="330" height="40" align-x="16" align-y="10804.46" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="z_D24"><ws:math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">z_D24</ml:id><ml:apply><ml:id xml:space="preserve">z_sec</ml:id><ml:sequence><ml:id xml:space="preserve">B</ml:id><ml:id xml:space="preserve">D</ml:id><ml:id xml:space="preserve">t_min</ml:id></ml:sequence></ml:apply></ml:define></ws:math></ws:region><ws:region region-id="379" left="355" top="10778.46" width="150" height="40" align-x="355" align-y="10804.46" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_z_D24"><ws:math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">z_D24</ml:id><ml:unitOverride><ml:id xml:space="preserve">mm</ml:id></ml:unitOverride></ml:eval></ws:math></ws:region><ws:region region-id="380" left="16" top="10822.46" width="330" height="40" align-x="16" align-y="10848.46" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="I_D24"><ws:math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">I_D24</ml:id><ml:apply><ml:id xml:space="preserve">I_sec</ml:id><ml:sequence><ml:id xml:space="preserve">B</ml:id><ml:id xml:space="preserve">D</ml:id><ml:id xml:space="preserve">t_min</ml:id></ml:sequence></ml:apply></ml:define></ws:math></ws:region><ws:region region-id="381" left="355" top="10822.46" width="150" height="40" align-x="355" align-y="10848.46" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_I_D24"><ws:math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">I_D24</ml:id><ml:unitOverride><ml:apply><ml:pow /><ml:id xml:space="preserve">mm</ml:id><ml:real>4</ml:real></ml:apply></ml:unitOverride></ml:eval></ws:math></ws:region><ws:region region-id="382" left="16" top="10866.46" width="330" height="40" align-x="16" align-y="10892.46" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="Ix_D24"><ws:math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">Ix_D24</ml:id><ml:apply><ml:id xml:space="preserve">Ix_sec</ml:id><ml:sequence><ml:id xml:space="preserve">B</ml:id><ml:id xml:space="preserve">D</ml:id><ml:id xml:space="preserve">t_min</ml:id></ml:sequence></ml:apply></ml:define></ws:math></ws:region><ws:region region-id="383" left="355" top="10866.46" width="150" height="40" align-x="355" align-y="10892.46" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_Ix_D24"><ws:math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">Ix_D24</ml:id><ml:unitOverride><ml:apply><ml:pow /><ml:id xml:space="preserve">mm</ml:id><ml:real>4</ml:real></ml:apply></ml:unitOverride></ml:eval></ws:math></ws:region><ws:region region-id="384" l