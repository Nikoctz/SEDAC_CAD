:space="preserve">sin</ml:id><ml:id xml:space="preserve">angulo_eslinga</ml:id></ml:apply><ml:id xml:space="preserve">cuna_Zout</ml:id></ml:apply></ml:apply></ml:parens></ml:apply></ml:define></ws:math></ws:region><ws:region region-id="332" left="355" top="8074.90" width="150" height="40" align-x="355" align-y="8100.90" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_cuna_sigma"><ws:math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">cuna_sigma</ml:id><ml:unitOverride><ml:id xml:space="preserve">MPa</ml:id></ml:unitOverride></ml:eval></ws:math></ws:region><ws:region region-id="333" left="16" top="8118.90" width="330" height="40" align-x="16" align-y="8144.90" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="n_puente_cuna"><ws:math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">n_puente_cuna</ml:id><ml:apply><ml:div /><ml:id xml:space="preserve">Sy_al</ml:id><ml:id xml:space="preserve">cuna_sigma</ml:id></ml:apply></ml:define></ws:math></ws:region><ws:region region-id="334" left="355" top="8118.90" width="150" height="40" align-x="355" align-y="8144.90" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_n_puente_cuna"><ws:math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">n_puente_cuna</ml:id></ml:eval></ws:math></ws:region><ws:region region-id="335" left="16" top="8162.90" width="490" height="45" align-x="16" align-y="8192.15" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><ws:text use-page-width="false" push-down="false" lock-width="true"><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">Se toma la carga completa del lado, no la mitad de la cuna. El reparto real entre ramas de</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">correa y la rigidez del arnes no estan medidos: son la fuente mas probable de error de este</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">bloque.</ws:c></ws:f></ws:p></ws:text></ws:region><ws:region region-id="336" left="16" top="8352.79" width="490" height="20" align-x="16" align-y="8365.79" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><ws:text use-page-width="false" push-down="false" lock-width="true"><ws:p style="Normal"><ws:f family="Arial" charset="0" size="9"><ws:b><ws:c val="#687A88">SEDAC / P2.04-P2.05 / MC01</ws:c></ws:b></ws:f></ws:p></ws:text></ws:region><ws:region region-id="337" left="16" top="8378.79" width="490" height="28" align-x="16" align-y="8396.99" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><ws:text use-page-width="false" push-down="false" lock-width="true"><ws:p style="Normal"><ws:f family="Arial" charset="0" size="14"><ws:b><ws:c val="#123B54">9. Resumen del cribado</ws:c></ws:b></ws:f></ws:p></ws:text></ws:region><ws:region region-id="338" left="16" top="8412.79" width="490" height="18" align-x="16" align-y="8424.49" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><ws:text use-page-width="false" push-down="false" lock-width="true"><ws:p style="Normal"><ws:f family="Arial" charset="0" size="9"><ws:c val="#687A88">Quince verificaciones, umbral de margen objetivo y cierre de junta.</ws:c></ws:f></ws:p></ws:text></ws:region><ws:region region-id="339" left="16" top="8436.79" width="330" height="44" align-x="16" align-y="8465.39" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="n_min"><ws:math optimize="false" disable-calc="false"><ml:define><ml: