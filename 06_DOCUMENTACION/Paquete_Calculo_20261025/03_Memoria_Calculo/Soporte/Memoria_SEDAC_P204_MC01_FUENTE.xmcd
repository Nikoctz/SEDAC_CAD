ground-color="inherit" tag="eval_n_arb_tuerca"><ws:math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">n_arb_tuerca</ml:id></ml:eval></ws:math></ws:region><ws:region region-id="309" left="16" top="7889.01" width="490" height="71" align-x="16" align-y="7935.16" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><ws:text use-page-width="false" push-down="false" lock-width="true"><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">El pasador transmite cortante; la precarga la aporta el M5 interior. El casquillo es un tope</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">de compresion entre alas: su funcion depende de la longitud ajustada al interior real.</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">Ninguna de estas verificaciones cubre roscas, par de apriete, prueba de tuerca autofrenante</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">ni desgaste. SUPUESTOS heredados de calcular_p2_05.py:63,71: OD efectivo 9,9 mm e ID 5,6 mm.</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">No son medidas ni tolerancias aprobadas. El taladro de 10,2 mm es otra cota.</ws:c></ws:f></ws:p></ws:text></ws:region><ws:region region-id="310" left="16" top="7594.90" width="490" height="20" align-x="16" align-y="7607.90" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><ws:text use-page-width="false" push-down="false" lock-width="true"><ws:p style="Normal"><ws:f family="Arial" charset="0" size="9"><ws:b><ws:c val="#687A88">SEDAC / P2.04-P2.05 / MC01</ws:c></ws:b></ws:f></ws:p></ws:text></ws:region><ws:region region-id="311" left="16" top="7620.90" width="490" height="28" align-x="16" align-y="7639.10" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><ws:text use-page-width="false" push-down="false" lock-width="true"><ws:p style="Normal"><ws:f family="Arial" charset="0" size="14"><ws:b><ws:c val="#123B54">8. Puentes de anclaje y puente inferior de cuna</ws:c></ws:b></ws:f></ws:p></ws:text></ws:region><ws:region region-id="312" left="16" top="7654.90" width="490" height="18" align-x="16" align-y="7666.60" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><ws:text use-page-width="false" push-down="false" lock-width="true"><ws:p style="Normal"><ws:f family="Arial" charset="0" size="9"><ws:c val="#687A88">Cargas de correa con el angulo de eslinga hipotetico y reparto de carga no medido.</ws:c></ws:f></ws:p></ws:text></ws:region><ws:region region-id="313" left="16" top="7678.90" width="330" height="40" align-x="16" align-y="7704.90" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="Tstrap"><ws:math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">Tstrap</ml:id><ml:apply><ml:div /><ml:id xml:space="preserve">N_lado</ml:id><ml:apply><ml:mult /><ml:real>2</ml:real><ml:apply><ml:id xml:space="preserve">cos</ml:id><ml:id xml:space="preserve">angulo_eslinga</ml:id></ml:apply></ml:apply></ml:apply></ml:define></ws:math></ws:region><ws:region region-id="314" left="355" top="7678.90" width="150" height="40" align-x="355" align-y="7704.90" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_Tstrap"><ws:math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">Tstrap</ml:id><ml:unitOverride><ml:id xml:space="preserve">N</ml:id></ml:unitOverride></ml:eval></ws:math></ws:region><ws:region region-id="315" left="16" top="7722.90" width="330" height="40" align-x="16" align-y