op="5549.23" width="150" height="40" align-x="355" align-y="5575.23" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_N_lado"><ws:math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">N_lado</ml:id><ml:unitOverride><ml:id xml:space="preserve">N</ml:id></ml:unitOverride></ml:eval></ws:math></ws:region><ws:region region-id="205" left="16" top="5593.23" width="330" height="40" align-x="16" align-y="5619.23" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="Q_lado"><ws:math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">Q_lado</ml:id><ml:apply><ml:mult /><ml:id xml:space="preserve">Fh</ml:id><ml:id xml:space="preserve">frac</ml:id></ml:apply></ml:define></ws:math></ws:region><ws:region region-id="206" left="355" top="5593.23" width="150" height="40" align-x="355" align-y="5619.23" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_Q_lado"><ws:math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">Q_lado</ml:id><ml:unitOverride><ml:id xml:space="preserve">N</ml:id></ml:unitOverride></ml:eval></ws:math></ws:region><ws:region region-id="207" left="16" top="5637.23" width="330" height="40" align-x="16" align-y="5663.23" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="M0"><ws:math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">M0</ml:id><ml:apply><ml:mult /><ml:id xml:space="preserve">N_lado</ml:id><ml:id xml:space="preserve">excentricidad</ml:id></ml:apply></ml:define></ws:math></ws:region><ws:region region-id="208" left="355" top="5637.23" width="150" height="40" align-x="355" align-y="5663.23" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_M0"><ws:math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">M0</ml:id><ml:unitOverride><ml:apply><ml:mult /><ml:id xml:space="preserve">N</ml:id><ml:id xml:space="preserve">mm</ml:id></ml:apply></ml:unitOverride></ml:eval></ws:math></ws:region><ws:region region-id="209" left="16" top="5681.23" width="490" height="58" align-x="16" align-y="5718.93" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><ws:text use-page-width="false" push-down="false" lock-width="true"><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">La envolvente reune casos alternativos, no un unico diagrama de cargas simultaneas. La</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">funcion M_env se declara despues de las cargas porque usa M0, Q_lado y L_luz: en Mathcad una</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">funcion se evalua en el momento de declararse y no se resuelve si sus variables todavia no</ws:c></ws:f></ws:p><ws:p style="Normal"><ws:f family="Arial" charset="0" size="10"><ws:c val="#253746">existen.</ws:c></ws:f></ws:p></ws:text></ws:region><ws:region region-id="210" left="16" top="5745.23" width="490" height="52" align-x="16" align-y="5779.03" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="M_env"><ws:math optimize="false" disable-calc="false"><ml:define><ml:function><ml:id xml:space="preserve">M_env</ml:id><ml:boundVars><ml:id>x</ml:id></ml:boundVars></ml:function><ml:apply><ml:plus /><ml:apply><ml:mult /><ml:id xml:space="preserve">M0</ml:id><ml:apply><ml:id xml:space="preserve">max</ml:id><ml:sequence><ml:apply><ml:minus /><ml:real>1</ml:real><ml:apply><ml:div /><ml:id xml:space="preserve">x</ml:id><ml:id xml:space="preserve">L_luz</ml:id></ml:apply></ml:apply><ml:apply><ml:div /><ml:id xml:space="preserve">x</ml:id><ml:id xml:space="preserve">L_luz</ml:id></ml:apply></ml:sequence></ml:apply></ml:apply><ml:apply><ml:div /><ml:apply><ml:mult /><ml:apply><ml:mult /><ml:id xml:space="preserve">Q_lado</ml:id><ml:id xml:space="preserve">x</ml:id></ml:apply><ml:parens><ml:apply><ml:minus /><ml:id xml:space="preserve">L_luz</ml:id><ml:id xml:space="preserve">x</ml:id></ml:apply></ml:parens></ml:apply><ml:id xml:space="preserve">L_luz</ml:id></ml:apply></ml:apply></ml:define></ws:math></ws:region><ws:region region-id="211" left="16" top="5802.23" width="330" height="40" align-x="16" align-y="5828.23" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="step"><ws:math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">step</ml:id><ml:apply><ml:div /><ml:id xml:space="preserve">L_luz</ml:id><ml:real>800</ml:real></ml:apply></ml:define></ws:math></ws:region><ws:region region-id="212" left="355" top="5802.23" width="150" height="40" align-x="355" align-y="5828.23" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_step"><ws:math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">step</ml:id><ml:unitOverride><ml:id xml:space="preserve">mm</ml:id></ml:unitOverride></ml:eval></ws:math></ws:region><ws:region region-id="213" left="16" top="5846.23" width="330" height="40" align-x="16" align-y="5872.23" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="x_cont"><ws:math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">x_cont</ml:id><ml:apply><ml:div /><ml:parens><ml:apply><ml:minus /><ml:id xml:space="preserve">L_luz</ml:id><ml:apply><ml:div /><ml:id xml:space="preserve">M0</ml:id><ml:id xml:space="preserve">Q_lado</ml:id></ml:apply></ml:apply></ml:parens><ml:real>2</ml:real></ml:apply></ml:define></ws:math></ws:region><ws:region regio