et="0" size="10"><c val="#253746">Mass=25 kg es la masa TOTAL de cálculo: bomba, líquido, estructura, arnés y accesorios. No</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">son 25 kg de bomba más el soporte. av=3 corresponde a 3g totales; eta=0,7 representa el lado</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">más cargado. Si la masa total real supera 25 kg, recalcular.</c></f></p></text></region><region region-id="20" left="16" top="773.89" width="490" height="20" align-x="16" align-y="786.89" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="9"><b><c val="#687A88">SEDAC / P2.03 / MC02</c></b></f></p></text></region><region region-id="21" left="16" top="799.89" width="490" height="28" align-x="16" align-y="818.09" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="14"><b><c val="#123B54">2. Geometría y criterio</c></b></f></p></text></region><region region-id="22" left="16" top="833.89" width="330" height="48" align-x="16" align-y="865.09" show-border="false" show-highlight="true" is-protected="false" z-order="0" background-color="#F0F6FC" tag="H"><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">H</ml:id><ml:apply><ml:mult/><ml:real>500</ml:real><ml:id xml:space="preserve">mm</ml:id></ml:apply></ml:define></math></region><region region-id="23" left="355" top="833.89" width="150" height="48" align-x="355" align-y="865.09" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_H"><math optimize="false" disable-calc="false"><ml:eval><ml:id x