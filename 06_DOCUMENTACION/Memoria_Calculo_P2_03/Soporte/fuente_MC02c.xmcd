<ml:real>3</ml:real><ml:apply><ml:pow/><ml:parens><ml:apply><ml:plus/><ml:id xml:space="preserve">TauT</ml:id><ml:id xml:space="preserve">TauV</ml:id></ml:apply></ml:parens><ml:real>2</ml:real></ml:apply></ml:apply></ml:apply></ml:apply></ml:apply></ml:define></math></region><region region-id="116" left="20" top="4675.34" width="150" height="34" align-x="20" align-y="4697.4400000000005" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_SigVM"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">SigVM</ml:id><ml:unitOverride><ml:id xml:space="preserve">MPa</ml:id></ml:unitOverride></ml:eval></math></region><region region-id="117" left="16" top="4710.34" width="330" height="48" align-x="16" align-y="4741.54" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="nRail"><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">nRail</ml:id><ml:apply><ml:div/><ml:id xml:space="preserve">SyR</ml:id><ml:id xml:space="preserve">SigVM</ml:id></ml:apply></ml:define></math></region><region region-id="118" left="355" top="4710.34" width="150" height="48" align-x="355" align-y="4741.54" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_nRail"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">nRail</ml:id></ml:eval></math></region><region region-id="119" left="16" top="4762.34" width="490" height="45" align-x="16" align-y="4791.59" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">La envolvente mantiene el modelo previo: flexión biaxial, torsión de tubo cerrado y cortante</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">medio. V/A no reproduce el campo local ni las tensiones de los taladros. La combinación de</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">máximos no es una solución tridimensional del arnés.</c></f></p></text></region><region region-id="120" left="16" top="5321.23" width="490" height="20" align-x="16" align-y="5334.23" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="9"><b><c val="#687A88">SEDAC / P2.03 / MC02</c></b></f></p></text></region><region region-id="121" left="16" top="5347.23" width="490" height="28" align-x="16" align-y="5365.429999999999" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="14"><b><c val="#123B54">7. Riel: flecha y pandeo ideal</c></b></f></p></text></region><region region-id="122" left="16" top="5381.23" width="490" height="48" align-x="16" align-y="5412.429999999999" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="deltaH"><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">deltaH</ml:id><ml:apply><ml:div/><ml:apply><ml:mult/><ml:apply><ml:mult/><ml:id xml:space="preserve">eta</ml:id><ml:id xml:space="preserve">Fh</ml:id></ml:apply><ml:apply><ml:pow/><ml:id xml:space="preserve">Le</ml:id><ml:real>3</ml:real></ml:apply></ml:apply><ml:apply><ml:mult/><ml:apply><ml:mult/><ml:real>3</ml:real><ml:id xml:space="preserve">Eal</ml:id></ml:apply><ml:apply><ml:id xml:space="preserve">min</ml:id><ml:sequence><ml:id xml:space="preserve">Ix</ml:id><ml:id xml:space="preserve">Iz</ml:id></ml:sequence></ml:apply></ml:apply></ml