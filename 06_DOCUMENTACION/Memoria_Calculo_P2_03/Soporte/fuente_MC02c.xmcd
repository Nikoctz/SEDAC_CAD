e" disable-calc="false"><ml:define><ml:function><ml:id xml:space="preserve">Ir</ml:id><ml:boundVars><ml:id>B</ml:id><ml:id>DD</ml:id><ml:id>R</ml:id></ml:boundVars></ml:function><ml:apply><ml:minus/><ml:apply><ml:div/><ml:apply><ml:mult/><ml:id xml:space="preserve">B</ml:id><ml:apply><ml:pow/><ml:id xml:space="preserve">DD</ml:id><ml:real>3</ml:real></ml:apply></ml:apply><ml:real>12</ml:real></ml:apply><ml:apply><ml:mult/><ml:real>4</ml:real><ml:apply><ml:id xml:space="preserve">Jc</ml:id><ml:sequence><ml:apply><ml:minus/><ml:apply><ml:div/><ml:id xml:space="preserve">DD</ml:id><ml:real>2</ml:real></ml:apply><ml:id xml:space="preserve">R</ml:id></ml:apply><ml:id xml:space="preserve">R</ml:id></ml:sequence></ml:apply></ml:apply></ml:apply></ml:define></math></region><region region-id="73" left="16" top="2680.67" width="490" height="45" align-x="16" align-y="2709.92" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">Ar devuelve área; Ir devuelve segundo momento de área. Jc resta una esquina, no es una</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">constante de torsión. Los argumentos B, DD, R, c y r son variables locales de la función; no</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">necesitan definición global.</c></f></p></text></region><region region-id="74" left="16" top="3047.56" width="490" height="20" align-x="16" align-y="3060.56" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="9"><b><c val="#687A88">SEDAC / P2.03 / MC02</c></b></f></p></text></region><region region-id="75" left="16" top="3073.56" w