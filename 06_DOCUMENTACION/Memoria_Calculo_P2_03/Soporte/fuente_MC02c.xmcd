MPa a temperatura ambiente; no sustituir automáticamente por A2-70.</c></f></p></text></region><region region-id="510" left="16" top="26542.149999999998" width="490" height="20" align-x="16" align-y="26555.149999999998" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="9"><b><c val="#687A88">SEDAC / P2.03 / MC02</c></b></f></p></text></region><region region-id="511" left="16" top="26568.149999999998" width="490" height="28" align-x="16" align-y="26586.35" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="14"><b><c val="#123B54">21. Pasadores huecos de las cartelas</c></b></f></p></text></region><region region-id="512" left="16" top="26602.149999999998" width="330" height="48" align-x="16" align-y="26633.35" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="Apin"><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">Apin</ml:id><ml:apply><ml:mult/><ml:apply><ml:div/><ml:id xml:space="preserve">π</ml:id><ml:real>4</ml:real></ml:apply><ml:parens><ml:apply><ml:minus/><ml:apply><ml:pow/><ml:parens><ml:apply><ml:mult/><ml:real>10</ml:real><ml:id xml:space="preserve">mm</ml:id></ml:apply></ml:parens><ml:real>2</ml:real></ml:apply><ml:apply><ml:pow/><ml:parens><ml:apply><ml:mult/><ml:real>6.6</ml:real><ml:id xml:space="preserve">mm</ml:id></ml:apply></ml:parens><ml:real>2</ml:real></ml:apply></ml:apply></ml:parens></ml:apply></ml:define></math></region><region region-id="513" left="355" top="26602.149999999998" width="150" height="48" align-x="355" align-y="26633.35" show-border="false" show-highlight="false" is-protected="fals