l:space="preserve">SyR</ml:id><ml:apply><ml:div/><ml:apply><ml:mult/><ml:id xml:space="preserve">eta</ml:id><ml:id xml:space="preserve">Fv</ml:id></ml:apply><ml:apply><ml:mult/><ml:apply><ml:mult/><ml:real>5</ml:real><ml:id xml:space="preserve">mm</ml:id></ml:apply><ml:id xml:space="preserve">rt</ml:id></ml:apply></ml:apply></ml:apply></ml:define></math></region><region region-id="262" left="20" top="11947.35" width="150" height="34" align-x="20" align-y="11969.45" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_nRibBear"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">nRibBear</ml:id></ml:eval></math></region><region region-id="263" left="16" top="11982.35" width="490" height="45" align-x="16" align-y="12011.6" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">Tres tubos 20x10x1,5; el modelo asigna 70% de Fv a un solo tubo y usa luz 250 mm, mayor que</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">la distancia entre ejes M5. La carga vertical apoya sobre cartelas; el M5 retiene el</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">conjunto y el casquillo evita aplastamiento por apriete.</c></f></p></text></region><region region-id="264" left="16" top="12142.24" width="490" height="20" align-x="16" align-y="12155.24" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="9"><b><c val="#687A88">SEDAC / P2.03 / MC02</c></b></f></p></text></region><region region-id="265" left="16" top="12168.24" width="490" height="28" align-x="16" align-y="12186.44" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="14"><b><c val="#123B54">13. Anclajes nervados: sección de los puentes</c></b></f></p></text></region><region region-id="266" left="16" top="12202.24" width="330" height="48" align-x="16" align-y="12233.44" show-border="false" show-highlight="true" is-protected="false" z-order="0" background-color="#F0F6FC" tag="ta"><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">ta</ml:id><ml:apply><ml:mult/><ml:real>2</ml:real><ml:id xml:space="preserve">mm</ml:id></ml:apply></ml:define></math></region><region region-id="267" left="355" top="12202.24" width="150" height="48" align-x="355" align-y="12233.44" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_ta"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">ta</ml:id><ml:unitOverride><ml:id xml:space="preserve">mm</ml:id></ml:unitOverride></ml:eval></math></region><region region-id="268" left="16" top="12254.24" width="330" height="48" align-x="16" align-y="12285.44" show-border="false" show-highlight="true" is-protected="false" z-order="0" background-color="#F0F6FC" tag="tp"><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">tp</ml:id><ml:apply><ml:mult/><ml:real>1.8</ml:real><ml:id xml:space="preserve">mm</ml:id></ml:apply></ml:define></math></region><region region-id="269" left="355" top="12254.24" width="150" height="48" align-x="355" align-y="12285.44" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_tp"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">tp</ml:id><ml:unitOverride><ml:id xml:space="preserve">mm</ml:id></ml:unitOverride></ml:eval></math></region><region region-id="270" left="16" top="12306.24" width="330" height="48" align-x="16" align-y="12337.44" show-border="false" show-highlight="true" is-protected="false" z-order="0" background-color="#F0F6FC" tag="dp"><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">dp</ml:id><ml:apply><ml:mult/><ml:real>18</ml:real><ml:id xml:space="preserve">mm</ml:id></ml:apply></ml:define></math></region><region region-id="271" left="355" top="12306.24" width="150" height="48" align-x="355" align-y="12337.44" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_dp"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">dp</ml:id><ml:unitOverride><ml:id xml:space="preserve">mm</ml:id></ml:unitOverride></ml:eval></math></region><region region-id="272" left="16" top="12358.24" width="330" height="48" align-x="16" align-y="12389.44" show-border="false" show-highlight="true" is-protected="false" z-order="0" background-color="#F0F6FC" tag="slot"><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">slot</ml:id><ml:apply><ml:mult/><ml:real>52</ml:real><ml:id xml:space="preserve">mm</ml:id></ml:apply></ml:define></math></region><region region-id="273" left="355" top="12358.24" width="150" height="48" align-x="355" align-y="12389.44" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_slot"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">slot</ml:id><ml:unitOverride><ml:id xml:space="preserve">mm</ml:id></ml:unitOverride></ml:eval></math></region><region region-id="274" left="16" top="12410.24" width="490" height="45" align-x="16" align-y="12439.49" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">Anclajes mecanizados 6061-T6: alma nominal 2 mm y retorno hasta 18 mm. Se calcula con pared</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">mínima 1,8 mm. El puente es una sección L asimétrica; usar solo I/c sería incorrecto por el</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">producto de inercia.</c></f></p></text></region><region region-id="275" left="16" top="12900.13" width="490" height="20" align-x="16" align-y="12913.13" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="9"><b><c val="#687A88">SEDAC / P2.03 / MC02</c></b></f></p></text></region><region region-id="276" left="16" top="12926.13" width="490" height="28" align-x="16" align-y="12944.33" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="14"><b><c val="#123B54">14. Puente hombro: flexión asimétrica</c></b></f></p></text></region><region region-id="277" left="16" top="12960.13" width="330" height="48" align-x="16" align-y="12991.33" show-border="false" show-highlight="true" is-protected="false" z-order="0" background-color="#F0F6FC" tag="Lsa"><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">Lsa</ml:id><ml:apply><ml:mult/><ml:real>24</ml:real><ml:id xml:space="preserve">mm</ml:id></ml:apply></ml:define></math></region><region region-id="278" left="355" top="12960.13" width="150" height="48" align-x="355" align-y="12991.33" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_Lsa"><m