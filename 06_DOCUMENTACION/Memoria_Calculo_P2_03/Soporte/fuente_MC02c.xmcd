region region-id="624" left="20" top="31375.489999999998" width="150" height="34" align-x="20" align-y="31397.589999999997" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_MinContact"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">MinContact</ml:id></ml:eval></math></region><region region-id="625" left="16" top="31410.489999999998" width="490" height="48" align-x="16" align-y="31441.69" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="MinModel"><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">MinModel</ml:id><ml:apply><ml:id xml:space="preserve">min</ml:id><ml:sequence><ml:id xml:space="preserve">MinFrame</ml:id><ml:id xml:space="preserve">MinJoint</ml:id><ml:id xml:space="preserve">MinHarness</ml:id><ml:id xml:space="preserve">MinBrace</ml:id><ml:id xml:space="preserve">MinContact</ml:id></ml:sequence></ml:apply></ml:define></math></region><region region-id="626" left="20" top="31462.489999999998" width="150" height="34" align-x="20" align-y="31484.589999999997" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_MinModel"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">MinModel</ml:id></ml:eval></math></region><region region-id="627" left="16" top="31497.489999999998" width="490" height="45" align-x="16" align-y="31526.739999999998" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">MinModel es el menor margen de estos modelos parciales, no un factor de seguridad global.</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">Aceptación del prediseño: todos &gt;=2,2; flecha &lt;=5 mm; Clamp positivos. Las verificaciones no</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">calculadas no se consideran aprobadas.</c></f></p></text></region><region region-id="628" left="16" top="31847.38" width="490" height="20" align-x="16" align-y="31860.38" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="9"><b><c val="#687A88">SEDAC / P2.03 / MC02</c></b></f></p></text></region><region region-id="629" left="16" top="31873.38" width="490" height="28" align-x="16" align-y="31891.58" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="14"><b><c val="#123B54">25. Masa completa: CAD y reservas</c></b></f></p></text></region><region region-id="630" left="16" top="31907.38" width="490" height="58" align-x="16" align-y="31945.08" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">La masa CAD es una lectura de geometría y densidad; editar Mathcad no cambia esa geometría.</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">Volver a generar y pesar después de cada modificación. El HDPE está incluido. La espuma</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">mostrada como referencia pertenece a la reserva textil y se excluye de mCAD para no sumarla</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">dos veces.</c></f></p></text></region><region region-id="631" left="16" top="31971.38" width="330" height="48" align-x="16" align-y="32002.58" show-border="false" show-highlight="true" is-protected="false" z-order="0" background-color="#F0F6FC" tag="mCAD"><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">mCAD</ml:id><ml:apply><ml:mult/><ml:real>2.333128413437</ml:real><ml:id xml:space="preserve">kg</ml:id></ml:apply></ml:define></math></region><region region-id="632" left="355" top="31971.38" width="150" height="48" align-x="355" align-y="32002.58" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_mCAD"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">mCAD</ml:id><ml:unitOverride><ml:id xml:space="preserve">kg</ml:id></ml:unitOverride></ml:eval></math></region><region region-id="633" left="16" top="32023.38" width="330" height="48" align-x="16" align-y="32054.58" show-border="false" show-highlight="true" is-protected="false" z-order="0" background-color="#F0F6FC" tag="mHarness"><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">mHarness</ml:id><ml:apply><ml:mult/><ml:real>0.5</ml:real><ml:id xml:space="preserve">kg</ml:id></ml:apply></ml:define></math></region><region region-id="634" left="355" top="32023.38" width="150" height="48" align-x="355" align-y="32054.58" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_mHarness"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">mHarness</ml:id><ml:unitOverride><ml:id xml:space="preserve">kg</ml:id></ml:unitOverride></ml:eval></math></region><region region-id="635" left="16" top="32075.38" width="330" height="48" align-x="16" align-y="32106.58" show-border="false" show-highlight="true" is-protected="false" z-order="0" background-color="#F0F6FC" tag="mExtra"><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">mExtra</ml:id><ml:apply><ml:mult/><ml:real>0.08</ml:real><ml:id xml:space="preserve">kg</ml:id></ml:apply></ml:define></math></region><region region-id="636" left="355" top="32075.38" width="150" height="48" align-x="355" align-y="32106.58" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_mExtra"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">mExtra</ml:id><ml:unitOverride><ml:id xml:space="preserve">kg</ml:id></ml:unitOverride></ml:eval></math></region><region region-id="637" left="16" top="32127.38" width="330" height="48" align-x="16" align-y="32158.58" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="mTotal"><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">mTotal</ml:id><ml:apply><ml:plus/><ml:apply><ml:plus/><ml:id xml:space="preserve">mCAD</ml:id><ml:id xml:space="preserve">mHarness</ml:id></ml:apply><ml:id xml:space="preserve">mExtra</ml:id></ml:apply></ml:define></math></region><region region-id="638" left="355" top="32127.38" width="150" height="48" align-x="355" align-y="32158.58" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_mTotal"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">mTotal</ml:id><ml:unitOverride><ml:id xml:space="preserve">kg</ml:id></ml:unitOverride></ml:eval></math></region><region region-id="639" left="16" top="32179.38" width="330" height="48" align-x="16" align-y="32210.58" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="mRestante"><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">mRestante</ml:id><ml:apply><ml:minus/><ml:id xml:space="preserve">Mass</ml:id><ml:id xml:space="preserve">mTotal</ml:id></ml:apply></ml:define></math></region><region region-id="640" left="355" top="32179.38" width="150" height="48" align-x="355" align-y="32210.58" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_mRestante"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">mRestante</ml:id><ml:unitOverride><ml:id xml:space="preserve">kg</ml:id></ml:unitOverride></ml:eval></math></region><region region-id="641" left="16" top="32231.38" width="490" height="32" align-x="16" align-y="32252.18" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">mRestante es la parte del presupuesto de 25 kg que quedaría para bomba, líquido y elementos</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">aún no incluidos. No es una capacidad de uso certificada.</c></f></p></text></region><region region-id="642" left="16" top="32269.38" width="330" height="48" align-x="16" align-y="32300.58" show-border="false" show-highlight="true" is-protected="false" z-order="0" background-color="#F0F6FC" tag="mGoal"><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">mGoal</ml:id><ml:apply><ml:mult/><ml:real>2.0</ml:real><ml:id xml:space="preserve">kg</ml:id></ml:apply></ml:define></math></region><region region-id="643" left="355" top="32269.38" width="150" height="48" align-x="355" align-y="32300.58" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_mGoal"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">mGoal</ml:id><ml:unitOverride><ml:id xml:space="preserve">kg</ml:id></ml:unitOverride></ml:eval></math></region><region region-id="644" left="16" top="32321.38" width="330" height="48" align-x="16" align-y="32352.58" show-border="false" show-highlight="true" is-protected="false" z-order="0" background-color="#F0F6FC" tag="mOld"><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">mOld</ml:id><ml:apply><ml:mult/><ml:real>3.2062576846</ml:real><ml:id xml:space="preserve">kg</ml:id></ml:apply></ml:define></math></region><region region-id="645" left="355" top="32321.38" width="150" height="48" align-x="355" align-y="32352.58" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_mOld"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">mOld</ml:id><ml:unitOverride><ml:id xml:space="preserve">kg</ml:id></ml:unitOverride></ml:eval></math></region><region region-id="646" left="16" top="32373.38" width="330" height="48" align-x="16" align-y="32404.58" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="savingCAD"><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">savingCAD</ml:id><ml:apply><ml:minus/><ml:real>1</ml:real><ml:apply><ml:div/><ml:id xml:space="preserve">mCAD</ml:id><ml:parens><ml:apply><ml:minus/><ml:id xml:space="preserve">mOld</ml:id><ml:apply><ml:mult/><ml:real>0.0532007361</ml:real><ml:id xml:space="preserve">kg</ml:id></ml:apply></ml:apply></ml:parens></ml:apply></ml:apply></ml:define></math></region><region region-id="647" left="355" top="32373.38" width="150" height="48" align-x="355" align-y="32404.58" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_savingCAD"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">savingCAD</ml:id></ml:eval></math></region><region region-id="648" left="16" top="32425.38" width="490" height="45" align-x="16" align-y="32454.63" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">Comparación equivalente: se retira del CAD viejo la espuma de referencia 0,0532 kg porque</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">está en la reserva textil. Los 0,50 kg de arnés y 0,08 kg de accesorios son reservas, no</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">mediciones. No confundir reducción CAD con masa final pesada.</c></f></p></text></region><region region-id="649" left="16" top="32605.27" width="490" height="20" align-x="16" align-y="32618.27" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="9"><b><c val="#687A88">SEDAC / P2.03 / MC02</c></b></f></p></text></region><region region-id="650" left="16" top="32631.27" width="490" height="28" align-x="16" align-y="32649.47" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="14"><b><c val="#123B54">26. Criterios de falla y trabajo pendiente</c></b></f></p></text></region><region region-id="651" left="16" top="32665.27" width="490" height="45" align-x="16" align-y="32694.52" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">Fluencia: Von Mises para aluminio y acero dúctiles. Aplastamiento, sección neta y</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">arrancamiento: modelos locales de placa. Inestabilidad: Euler y placa ideal. Rigidez: flecha</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">de viga equivalente.</c></f></p></text></region><region region-id="652" left="16" top="32716.27" width="490" height="45" align-x="16" align-y="32745.52" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">Fatiga: medir ciclos y amplitudes; obtener curvas S-N de material y detalle. Sin estos datos</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">no se asigna vida. Fractura: se necesitan tamaño de defecto, geometría y tenacidad. No se</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">sustituye por un margen de fluencia.</c></f></p></text></region><region region-id="653" left="16" top="32767.27" width="490" height="45" align-x="16" align-y="32796.520000000004" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">Faltan FEA de ranuras/uniones y pandeo perforado; tolerancias, dobleces, asiento de</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">casquillos, resistencia de tuercas y arandelas reales; vibración, impacto, temperatura,</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">corrosión, abrasión; costuras, hebillas, presión sobre el cuerpo y liberación.</c></f></p></text></region><region region-id="654" left="16" top="32818.270000000004" width="490" height="45" align-x="16" align-y="32847.520000000004" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">La bolsa se debe medir llena y vacía, con manguera y arnés. La escotadura frontal cambió; si</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">la manguera exige la escotadura anterior, el apoyo delantero y el piso deben recalcularse.</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">Esta revisión no autoriza fabricar ni ensayar sobre una persona.</c></f></p></text></region><region region-id="655" left="16" top="33363.159999999996" width="490" height="20" align-x="16" align-y="33376.159999999996" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="9"><b><c val="#687A88">SEDAC / P2.03 / MC02</c></b></f></p></text></region><region region-id="656" left="16" top="33389.159999999996" width="490" height="28" align-x="16" align-y="33407.35999999999" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="14"><b><c val="#123B54">27. Fuentes y uso</c></b></f></p></text></region><region region-id="657" left="16" top="33423.159999999996" width="490" height="45" align-x="16" align-y="33452.409999999996" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">Fuentes: Hydro 6061 (extrusión T6); Atlas Steels 5052 y TN14; Bossard fijaciones inoxidables</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">ISO 3506; NASA RP-1228 Fastener Design Manual; documentación Autodesk Inventor sobre roscas</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">cosméticas y restricciones; MIT OCW mecánica estructural. Enlaces y alcance en PDF y LEEME.</c></f></p></text></region><region region-id="658" left="16" top="33474.159999999996" width="490" height="45" align-x="16" align-y="33503.409999999996" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">Mathcad: editar entradas azules; Ctrl+F9 recalcula todo. := define, = evalúa, min/max</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">seleccionan extremos, sqrt devuelve raíz positiva. Mayúsculas y minúsculas distinguen</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">variables. Las funciones tienen argumentos locales.</c></f></p></text></region><region region-id="659" left="16" top="33525.159999999996" width="490" height="45" align-x="16" align-y="33554.409999999996" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">El archivo editable final tiene resultados guardados por Mathcad. Los borradores se</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">mantienen en Soporte. Solo el archivo terminado en EDITABLE.xmcd es el documento de lectura</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">principal.</c></f></p></text></region></regions></worksheet>