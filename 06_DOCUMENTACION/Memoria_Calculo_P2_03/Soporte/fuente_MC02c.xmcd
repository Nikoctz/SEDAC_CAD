d xml:space="preserve">mm</ml:id></ml:apply></ml:parens><ml:real>2</ml:real></ml:apply></ml:apply></ml:apply></ml:define></math></region><region region-id="529" left="20" top="27464.04" width="150" height="34" align-x="20" align-y="27486.14" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_Asp5"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">Asp5</ml:id><ml:unitOverride><ml:apply><ml:pow/><ml:id xml:space="preserve">mm</ml:id><ml:real>2</ml:real></ml:apply></ml:unitOverride></ml:eval></math></region><region region-id="530" left="16" top="27499.04" width="490" height="58" align-x="16" align-y="27536.74" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">Los apoyos interiores M5 son bloques de 10 mm de ancho, con contorno igual al interior</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">redondeado del tubo 20x10x1,5 y taladro 5,5. Se cuenta solo el asiento plano de 4 mm y se</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">resta el círculo completo del taladro: área resistente conservadora. No son tubos de</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">diámetro 9 mm.</c></f></p></text></region><region region-id="531" left="16" top="27563.04" width="490" height="48" align-x="16" align-y="27594.24" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="nSleeve6"><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">nSleeve6</ml:id><ml:apply><ml:div/><ml:id xml:space="preserve">SyR</ml:id><ml:apply><ml:div/><ml:parens><ml:apply><ml:plus/><ml:apply><ml:mult/><ml:id xml:space="preserv