rial" charset="0" size="10"><c val="#253746">ecc pasa de 100 a 107,5 mm por la mayor profundidad del riel. Le pasa de 400 a 423 mm por la</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">elevación de la cuna y su protector. Ambos ajustes son supuestos conservados para comparar,</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">pendientes de medir.</c></f></p></text></region><region region-id="43" left="16" top="1531.78" width="490" height="20" align-x="16" align-y="1544.78" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="9"><b><c val="#687A88">SEDAC / P2.03 / MC02</c></b></f></p></text></region><region region-id="44" left="16" top="1557.78" width="490" height="28" align-x="16" align-y="1575.98" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="14"><b><c val="#123B54">3. Materiales y factores locales</c></b></f></p></text></region><region region-id="45" left="16" top="1591.78" width="330" height="48" align-x="16" align-y="1622.98" show-border="false" show-highlight="true" is-protected="false" z-order="0" background-color="#F0F6FC" tag="SyR"><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">SyR</ml:id><ml:apply><ml:mult/><ml:real>240</ml:real><ml:id xml:space="preserve">MPa</ml:id></ml:apply></ml:define></math></region><region region-id="46" left="355" top="1591.78" width="150" height="48" align-x="355" align-y="1622.98" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_SyR"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:s