"><f family="Arial" charset="0" size="14"><b><c val="#123B54">4. Funciones para el tubo de esquinas redondeadas</c></b></f></p></text></region><region region-id="66" left="16" top="2349.67" width="330" height="48" align-x="16" align-y="2380.87" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="cero"><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">cero</ml:id><ml:apply><ml:minus/><ml:real>1</ml:real><ml:apply><ml:div/><ml:id xml:space="preserve">π</ml:id><ml:real>4</ml:real></ml:apply></ml:apply></ml:define></math></region><region region-id="67" left="355" top="2349.67" width="150" height="48" align-x="355" align-y="2380.87" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_cero"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">cero</ml:id></ml:eval></math></region><region region-id="68" left="16" top="2401.67" width="330" height="48" align-x="16" align-y="2432.87" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="cuno"><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">cuno</ml:id><ml:apply><ml:minus/><ml:apply><ml:div/><ml:real>1</ml:real><ml:real>3</ml:real></ml:apply><ml:apply><ml:div/><ml:id xml:space="preserve">π</ml:id><ml:real>16</ml:real></ml:apply></ml:apply></ml:define></math></region><region region-id="69" left="355" top="2401.67" width="150" height="48" align-x="355" align-y="2432.87" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_cuno"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">cuno</ml:id></ml:eval></math></region><region region-id="70" left="16" top="2453.67" width="490" height="76" align-x="16" align-y="2503.07" show-border="false" show-highlight="false" is-protected="false" 