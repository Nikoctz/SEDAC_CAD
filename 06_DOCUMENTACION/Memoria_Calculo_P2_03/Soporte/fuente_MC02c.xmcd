rder="0" background-color="inherit" tag="eval_SigFloor"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">SigFloor</ml:id><ml:unitOverride><ml:id xml:space="preserve">MPa</ml:id></ml:unitOverride></ml:eval></math></region><region region-id="238" left="16" top="10790.46" width="330" height="48" align-x="16" align-y="10821.66" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="nFloor"><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">nFloor</ml:id><ml:apply><ml:div/><ml:id xml:space="preserve">SyS</ml:id><ml:id xml:space="preserve">SigFloor</ml:id></ml:apply></ml:define></math></region><region region-id="239" left="355" top="10790.46" width="150" height="48" align-x="355" align-y="10821.66" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_nFloor"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">nFloor</ml:id></ml:eval></math></region><region region-id="240" left="16" top="10842.46" width="330" height="48" align-x="16" align-y="10873.66" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="tNeed"><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">tNeed</ml:id><ml:apply><ml:sqrt/><ml:apply><ml:div/><ml:apply><ml:mult/><ml:apply><ml:mult/><ml:real>6</ml:real><ml:id xml:space="preserve">Mfloor</ml:id></ml:apply><ml:id xml:space="preserve">nReq</ml:id></ml:apply><ml:id xml:space="preserve">SyS</ml:id></ml:apply></ml:apply></ml:define></math></region><region region-id="241" left="355" top="10842.46" width="150" height="48" align-x="355" align-y="10873.66" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_tNeed"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">tNeed</ml:id><ml:unitOverride><ml:id xml:space="preserve">mm</ml:id></ml:unitOverride></ml:eval></math></region><region region-id="242" left="16" top="10894.46" width="490" height="45" align-x="16" align-y="10923.71" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">M es momento por unidad de ancho y tiene unidad N. Presión doble y parche son una envolvente</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">local; su suma no es un caso global en equilibrio. Se retiene 2,5 mm. El tercer apoyo exige</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">comprobar la nueva salida frontal con la bomba real.</c></f></p></text></region><region region-id="243" left="16" top="11384.35" width="490" height="20" align-x="16" align-y="11397.35" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="9"><b><c val="#687A88">SEDAC / P2.03 / MC02</c></b></f></p></text></region><region region-id="244" left="16" top="11410.35" width="490" height="28" align-x="16" align-y="11428.550000000001" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="14"><b><c val="#123B54">12. Refuerzos bajo la cuna</c></b></f></p></text></region><region region-id="245" left="16" top="11444.35" width="330" height="48" align-x="16" align-y="11475.550000000001" show-border="false" show-highlight="true" is-protected="false" z-order="0" background-color="#F0F6FC" tag="rh"><math optimize="false" disable-calc="false"