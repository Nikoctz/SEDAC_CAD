al"><f family="Arial" charset="0" size="10"><c val="#253746">Se evalúan los seis vértices reales de la L. El máximo valor absoluto determina el módulo</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">resistente efectivo. Se conservan 52 mm de luz y el factor local 1,5; no se acredita la</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">rigidez de la cinta.</c></f></p></text></region><region region-id="314" left="16" top="15173.8" width="490" height="20" align-x="16" align-y="15186.8" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="9"><b><c val="#687A88">SEDAC / P2.03 / MC02</c></b></f></p></text></region><region region-id="315" left="16" top="15199.8" width="490" height="28" align-x="16" align-y="15218.0" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="14"><b><c val="#123B54">15. Puente cinturón: flexión asimétrica</c></b></f></p></text></region><region region-id="316" left="16" top="15233.8" width="330" height="48" align-x="16" align-y="15265.0" show-border="false" show-highlight="true" is-protected="false" z-order="0" background-color="#F0F6FC" tag="Lba"><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">Lba</ml:id><ml:apply><ml:mult/><ml:real>26</ml:real><ml:id xml:space="preserve">mm</ml:id></ml:apply></ml:define></math></region><region region-id="317" left="355" top="15233.8" width="150" height="48" align-x="355" align-y="15265.0" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_Lba"><math optimize="false" disable-calc="false"><ml