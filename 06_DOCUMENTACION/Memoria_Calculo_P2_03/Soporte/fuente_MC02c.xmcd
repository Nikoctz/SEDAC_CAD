r="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_nPin"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">nPin</ml:id></ml:eval></math></region><region region-id="520" left="16" top="26880.149999999998" width="490" height="48" align-x="16" align-y="26911.35" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="nPinBore"><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">nPinBore</ml:id><ml:apply><ml:div/><ml:id xml:space="preserve">SyR</ml:id><ml:apply><ml:div/><ml:id xml:space="preserve">Rpin</ml:id><ml:apply><ml:mult/><ml:apply><ml:mult/><ml:real>6</ml:real><ml:id xml:space="preserve">mm</ml:id></ml:apply><ml:id xml:space="preserve">tg</ml:id></ml:apply></ml:apply></ml:apply></ml:define></math></region><region region-id="521" left="20" top="26932.149999999998" width="150" height="34" align-x="20" align-y="26954.249999999996" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_nPinBore"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">nPinBore</ml:id></ml:eval></math></region><region region-id="522" left="16" top="26967.149999999998" width="490" height="58" align-x="16" align-y="27004.85" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">Cada pasador 6061 tiene exterior 10 mm, interior 6,6 mm y longitud nominal igual al paquete</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">de 53 mm. Atraviesa cartela y ambas paredes del riel por agujeros 10,2 mm. El diámetro</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">exterior distribuye el apoyo; se asigna toda la reacción tanto al pasador como al perno en</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">verificaciones separadas.</c></f></p></text></region><region region-id="523" left="16" top="27031.149999999998" width="490" height="45" align-x="16" align-y="27060.399999999998" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">Para montaje real deben controlarse longitud/planitud y contacto bajo las arandelas. No</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">aceptar un pasador sobresaliente que impida sujetar la cartela, ni uno corto que permita</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">aplastar el tubo. Falta definir tolerancia final con el taller.</c></f></p></text></region><region region-id="524" left="16" top="27300.04" width="490" height="20" align-x="16" align-y="27313.04" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="9"><b><c val="#687A88">SEDAC / P2.03 / MC02</c></b></f></p></text></region><region region-id="525" left="16" top="27326.04" width="490" height="28" align-x="16" align-y="27344.24" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="14"><b><c val="#123B54">22. Casquillos, asiento y cierre</c></b></f></p></text></region><region region-id="526" left="16" top="27360.04" width="330" height="48" align-x="16" align-y="27391.24" show-border="false" show-hi