<ml:div/><ml:id xml:space="preserve">SyR</ml:id><ml:id xml:space="preserve">SigFl</ml:id></ml:apply></ml:define></math></region><region region-id="208" left="355" top="9639.68" width="150" height="48" align-x="355" align-y="9670.880000000001" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_nFlange"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">nFlange</ml:id></ml:eval></math></region><region region-id="209" left="16" top="9691.68" width="490" height="45" align-x="16" align-y="9720.93" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">Se asigna 70% de toda Fv a un apoyo para revisar el ala. El brazo de 8 mm llega hasta el eje</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">del M5; no se permite adelgazarla a 3 mm. El cálculo de raíz no acredita el radio interior</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">ni la concentración del vaciado.</c></f></p></text></region><region region-id="210" left="16" top="9868.57" width="490" height="20" align-x="16" align-y="9881.57" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="9"><b><c val="#687A88">SEDAC / P2.03 / MC02</c></b></f></p></text></region><region region-id="211" left="16" top="9894.57" width="490" height="28" align-x="16" align-y="9912.77" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset=