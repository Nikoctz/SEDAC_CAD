<ml:mult/><ml:id xml:space="preserve">Ktorque</ml:id><ml:id xml:space="preserve">F05</ml:id></ml:apply><ml:real>5</ml:real></ml:apply><ml:id xml:space="preserve">mm</ml:id></ml:apply></ml:define></math></region><region region-id="573" left="355" top="29309.82" width="150" height="48" align-x="355" align-y="29341.02" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_Torque5"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">Torque5</ml:id><ml:unitOverride><ml:apply><ml:mult/><ml:id xml:space="preserve">N</ml:id><ml:id xml:space="preserve">m</ml:id></ml:apply></ml:unitOverride></ml:eval></math></region><region region-id="574" left="16" top="29361.82" width="490" height="45" align-x="16" align-y="29391.07" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">La prueba de tuerca clase 80 es un criterio distinto de fluencia y exige certificado del</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">producto autofrenante real. El par T=K*F0*d con K=0,20 es ilustrativo: falta sumar par</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">prevalente y calibrar fricción/lubricación. No es una instrucción de apriete.</c></f></p></text></region><region region-id="575" left="16" top="29412.82" width="490" height="58" align-x="16" align-y="29450.52" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">Tuerca autofrenante metálica derivada DIN 980, arandelas planas ISO 7089 y al menos dos</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">pasos de rosca salientes. Sujetar cabeza y tuerca con herramientas adecuadas; verificar</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">desgaste y las reglas de reutilización del proveedor. La rosca cosmética no representa la</c></f></p><p style="Normal"><f family="Arial" charset="0" size="10"><c val="#253746">deformación del autofreno. Ensayo vibratorio pendiente.</c></f></p></text></region><region region-id="576" left="16" top="29573.71" width="490" height="20" align-x="16" align-y="29586.71" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="9"><b><c val="#687A88">SEDAC / P2.03 / MC02</c></b></f></p></text></region><region region-id="577" left="16" top="29599.71" width="490" height="28" align-x="16" align-y="29617.91" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto"><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal"><f family="Arial" charset="0" size="14"><b><c val="#123B54">24. Resumen de comprobaciones analíticas</c></b></f></p></text></region><region region-id="578" left="22" top="29633.71" width="150" height="34" align-x="22" align-y="29655.809999999998" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_nRail"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="preserve">nRail</ml:id></ml:eval></math></region><region region-id="579" left="22" top="29663.71" width="150" height="34" align-x="22" align-y="29685.809999999998" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="eval_nMinWall"><math optimize="false" disable-calc="false"><ml:eval><ml:id xml:space="prese