					<f family="Arial" charset="0" size="10">
						<c val="#253746">Se asigna 70% de toda Fv a un apoyo para revisar el ala. El brazo de 8 mm llega hasta el eje</c>
					</f>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#253746">del M5; no se permite adelgazarla a 3 mm. El cálculo de raíz no acredita el radio interior</c>
					</f>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#253746">ni la concentración del vaciado.</c>
					</f>
				</p>
			</text>
			<rendering item-idref="209"/>
