		<region region-id="574" left="18" top="29384.25" width="489.75" height="36" align-x="18" align-y="29394" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#253746">La prueba de tuerca clase 80 es un criterio distinto de fluencia y exige certificado del</c>
					</f>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#253746">producto autofrenante real. El par T=K*F0*d con K=0,20 es ilustrativo: falta sumar par</c>
					</f>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#253746">prevalente y calibrar fricción/lubricación. No es una instrucción de apriete.</c>
					</f>
				</p>
			</text>
			<rendering item-idref="574"/>
		</region>
		<region region-id="575" left="18" top="29438.25" width="489.75" height="48" align-x="18" align-y="29448" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#253746">Tuerca autofrenante metálica derivada DIN 980, arandelas planas ISO 7089 y al menos dos</c>
					</f>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#253746">pasos de rosca salientes. Sujetar cabeza y tuerca con herramientas adecuadas; verificar</c>
					</f>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#253746">desgaste y las reglas de reutilización del proveedor. La rosca cosmética no representa la</c>
					</f>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#253746">deformación del autofreno. Ensayo vibratorio pendiente.</c>
					</f>
				</p>
			</text>
			<rendering item-idref="575"/>
		</region>
		<region region-id="576" left="18" top="29577" width="489.75" height="11.25" align-x="18" align-y="29586" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto">
