				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#253746">MinModel es el menor margen de estos modelos parciales, no un factor de seguridad global.</c>
					</f>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#253746">Aceptación del prediseño: todos &gt;=2,2; flecha &lt;=5 mm; Clamp positivos. Las verificaciones no</c>
					</f>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#253746">calculadas no se consideran aprobadas.</c>
					</f>
				</p>
			</text>
			<rendering item-idref="627"/>
		</region>
		<region region-id="628" left="18" top="31851" width="489.75" height="11.25" align-x="18" align-y="31860" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto">
