					<f family="Arial" charset="0" size="10">
						<c val="#253746">M es momento por unidad de ancho y tiene unidad N. Presión doble y parche son una envolvente</c>
					</f>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#253746">local; su suma no es un caso global en equilibrio. Se retiene 2,5 mm. El tercer apoyo exige</c>
					</f>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#253746">comprobar la nueva salida frontal con la bomba real.</c>
					</f>
				</p>
			</text>
