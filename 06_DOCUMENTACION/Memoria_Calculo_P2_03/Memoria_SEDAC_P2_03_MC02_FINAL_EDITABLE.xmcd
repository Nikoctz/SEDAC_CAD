		<region region-id="19" left="18" top="524.25" width="489.75" height="36" align-x="18" align-y="534" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="texto">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#253746">Mass=25 kg es la masa TOTAL de cálculo: bomba, líquido, estructura, arnés y accesorios. No</c>
					</f>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#253746">son 25 kg de bomba más el soporte. av=3 corresponde a 3g totales; eta=0,7 representa el lado</c>
					</f>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0" size="10">
						<c val="#253746">más cargado. Si la masa total real supera 25 kg, recalcular.</c>
					</f>
				</p>
			</text>
			<rendering item-idref="19"/>
		</region>
